<!-- components/timetable-grid/index.wxml -->
<view class="timetable theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="head">
    <view class="head-corner" aria-label="节次">{{themeId === 'campus' || themeId === 'swiss' ? '节次' : ''}}</view>
    <view class="head-day" wx:for="{{days}}" wx:key="index">{{item}}</view>
  </view>

  <view class="body">
    <view class="time-col">
      <view class="time-cell" wx:for="{{periods}}" wx:key="index">
        <text class="period-index">{{item.index}}</text>
        <view class="time-meta">
          <text class="time-range">{{item.start}}</text>
          <text class="time-range">{{item.end}}</text>
        </view>
      </view>
    </view>

    <view class="days">
      <view
        class="day-col"
        wx:for="{{columns}}"
        wx:key="day"
        wx:for-item="column"
      >
        <view
          class="pcell {{cell.selected ? 'selected' : ''}} {{cell.disabled ? 'disabled' : ''}} {{pressingKey === cell.key ? 'pressing' : ''}}"
          wx:for="{{column.cells}}"
          wx:key="key"
          wx:for-item="cell"
          data-key="{{cell.key}}"
          data-day="{{cell.day}}"
          data-period="{{cell.period}}"
          data-disabled="{{cell.disabled}}"
          data-selected="{{cell.selected}}"
          bindtouchstart="onCellTouchStart"
          bindtouchmove="onCellTouchMove"
          bindtouchend="onCellTouchEnd"
          bindtouchcancel="onCellTouchEnd"
          bindtap="onCellTap"
          aria-role="{{selectionMode ? 'checkbox' : 'button'}}"
          aria-label="{{days[cell.day - 1]}}第{{cell.period}}节{{cell.disabled ? '，已有课程不可选择' : cell.selected ? '，已选择' : '，空白'}}"
          aria-checked="{{selectionMode ? cell.selected : false}}"
          aria-disabled="{{selectionMode && cell.disabled && !cell.selected}}"
        >
          <text wx:if="{{cell.selected}}" class="selected-label">已选</text>
        </view>
        <view
          class="pressable card course-block course-{{themeId}} {{item.course.startPeriod === item.course.endPeriod ? 'single' : ''}} {{selectionMode ? 'selection-locked' : ''}}"
          wx:for="{{column.slots}}"
          wx:key="id"
          style="{{item.style}} background-color: {{item.backgroundColor}}; color: {{item.textColor}}; --course-accent: {{item.borderColor}};"
          data-id="{{item.course.id}}"
          hover-class="{{selectionMode ? 'none' : 'press-feedback'}}"
          hover-start-time="20"
          hover-stay-time="80"
          bindtap="onCardTap"
          aria-role="button"
          aria-label="{{days[column.day - 1]}}，{{item.course.name}}，第{{item.course.startPeriod}}到{{item.course.endPeriod}}节{{item.course.location ? '，教室' + item.course.location : ''}}{{selectionMode ? '，已有课程不可选择' : ''}}"
          aria-disabled="{{selectionMode}}"
        >
          <view class="course-rail" aria-hidden="true" />
          <view wx:if="{{themeId === 'pixel'}}" class="course-pixel-cap cap-top" aria-hidden="true" />
          <view wx:if="{{themeId === 'pixel'}}" class="course-pixel-cap cap-bottom" aria-hidden="true" />
          <text class="card-name">{{item.course.name}}</text>
          <text class="card-loc" wx:if="{{item.course.location}}">{{item.course.location}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
