<!-- components/timetable-grid/index.wxml -->
<view class="grid">
  <view class="corner"></view>

  <view
    class="day-head"
    wx:for="{{days}}"
    wx:key="index"
    style="grid-row: 1; grid-column: {{index + 2}};"
  >{{item}}</view>

  <view
    class="time-cell"
    wx:for="{{periods}}"
    wx:key="index"
    style="grid-row: {{index + 2}}; grid-column: 1;"
  >
    <text class="time-label">{{item.label}}</text>
    <text class="time-range">{{item.time}}</text>
  </view>

  <view
    class="card"
    wx:for="{{cards}}"
    wx:key="id"
    style="{{item.style}} background-color: {{item.course.color}};"
    data-id="{{item.course.id}}"
    bindtap="onCardTap"
  >
    <text class="card-name">{{item.course.name}}</text>
    <text class="card-loc" wx:if="{{item.course.location}}">{{item.course.location}}</text>
  </view>
</view>
