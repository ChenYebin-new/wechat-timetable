/* components/timetable-grid/index.wxss
   注意：单元格高度(124rpx)需与 constants/timetable.ts 的 CELL_HEIGHT 一致 */
.timetable {
  background: #e8efee;
  border-radius: 24rpx;
  padding: 8rpx;
  box-shadow: 0 12rpx 28rpx rgba(52, 83, 77, 0.07);
}

.head {
  display: flex;
}

.head-corner {
  width: 108rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #e8efee;
  color: #63756f;
  font-size: 19rpx;
  font-weight: 500;
  background: #dce5e3;
  border-radius: 18rpx;
  height: 80rpx;
}

.head-day {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 80rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8efee;
  font-size: 27rpx;
  font-weight: 600;
  color: #25453f;
  background: #d4ece7;
  border-radius: 18rpx;
}

.body {
  display: flex;
}

.time-col {
  width: 108rpx;
  flex-shrink: 0;
}

.time-cell {
  height: 124rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #3f5550;
  background: #f5f8f7;
  border: 2rpx solid #e8efee;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.period-index {
  margin-right: 6rpx;
  color: #2d4540;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1;
}

.time-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.time-range {
  color: #64756f;
  font-size: 22rpx;
  line-height: 1.25;
  font-variant-numeric: tabular-nums;
}

.days {
  flex: 1;
  display: flex;
}

.day-col {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.pcell {
  height: 124rpx;
  background: #f5f8f7;
  border: 2rpx solid #e8efee;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.card {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  border-radius: 20rpx;
  color: #ffffff;
  overflow: hidden;
  box-shadow: 0 8rpx 16rpx rgba(38, 72, 66, 0.12);
  box-sizing: border-box;
}

.card-name {
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-loc {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 6rpx;
  text-align: center;
}
