@import "../../styles/course-block.wxss";
@import "../../styles/interaction.wxss";
/* 124rpx rows + 80rpx header + 16rpx padding match timetable-layout.ts. */
.timetable { position:relative; padding:8rpx; background:var(--surface); border-radius:20rpx; overflow:hidden; }
.theme-cream { border-radius:16rpx; background:var(--page); }
/* Frame the grid itself once, without a second border around its padding. */
.theme-cream::after { content:''; position:absolute; inset:8rpx; border:1rpx solid var(--grid-line); border-radius:10rpx; pointer-events:none; }
.head { display:flex; border-radius:10rpx 10rpx 0 0; overflow:hidden; }
.head-corner,.head-day { display:flex; align-items:center; justify-content:center; height:80rpx; box-sizing:border-box; font-size:24rpx; font-weight:400; color:var(--text); background:var(--grid-head); border-right:1rpx solid var(--grid-line); border-bottom:1rpx solid var(--grid-line); }
.head-corner,.time-col { width:70rpx; flex-shrink:0; }
.head-corner { font-size:21rpx; }
.head-day { flex:1; min-width:0; }
.body { display:flex; border-radius:0 0 10rpx 10rpx; overflow:hidden; }
.time-cell { height:124rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8rpx; border-right:1rpx solid var(--grid-line); border-bottom:1rpx solid var(--grid-line); box-sizing:border-box; }
.period-index { font-size:30rpx; font-weight:600; line-height:1; color:var(--text); }
.time-meta { display:flex; flex-direction:column; align-items:center; }
.time-range { font-size:20rpx; line-height:1.3; color:var(--grid-time); font-variant-numeric:tabular-nums; }
.days { flex:1; display:flex; min-width:0; }
.day-col { position:relative; flex:1; min-width:0; display:flex; flex-direction:column; }
.pcell { position:relative; height:124rpx; border-right:1rpx solid var(--grid-line); border-bottom:1rpx solid var(--grid-line); box-sizing:border-box; overflow:hidden; }
.pcell.pressing { animation:hold-fill 1.2s linear forwards; }
.pcell.selected { background:var(--selected); box-shadow:inset 0 0 0 2rpx var(--accent); }
.pcell.disabled { background:transparent; }
.selected-label { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:18rpx; font-weight:600; }
.card { position:absolute; left:3rpx; right:3rpx; display:flex; flex-direction:column; align-items:flex-start; justify-content:center; padding:8rpx 4rpx 8rpx 18rpx; }
.card.selection-locked { pointer-events:none; }
.card-name { flex-shrink:0; max-width:2.4em; font-size:27rpx; font-weight:600; text-align:left; line-height:1.3; word-break:break-all; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:3; overflow:hidden; }
.card.single .card-name { font-size:25rpx; -webkit-line-clamp:2; }
.card-loc { flex-shrink:0; font-family:var(--font-numeric); font-size:22rpx; font-weight:400; margin-top:10rpx; line-height:1.25; text-align:left; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-variant-numeric:lining-nums tabular-nums; }
.card.single { padding-top:6rpx; padding-bottom:6rpx; }
.card.single .card-loc { margin-top:4rpx; font-size:21rpx; }
@keyframes hold-fill { from { background:var(--surface); } to { background:var(--selected); box-shadow:inset 0 0 0 2rpx var(--accent); } }

/* A: paper, serif typography and a fine ink rail. */
.theme-paper { font-family:var(--font-family); background:transparent; border-radius:8rpx; }
.theme-paper::after { content:''; position:absolute; inset:8rpx; border:1rpx solid var(--grid-line); border-radius:6rpx; pointer-events:none; }
.theme-paper .period-index,.theme-paper .time-range { font-variant-numeric:lining-nums tabular-nums; }
.theme-paper .head-day { font-size:24rpx; font-weight:700; }

.theme-paper .period-index { font-family:var(--font-numeric); font-weight:400; font-size:35rpx; }
.theme-paper .time-range { font-family:var(--font-numeric); font-size:21rpx; line-height:1.3; }

/* B: align names and rooms to one inset; the colored rule remains separate. */
.theme-swiss { background:white; border-radius:0; }
.theme-swiss .head,.theme-swiss .body { border-radius:0; }
.theme-swiss .head { position:relative; border-left:1rpx solid var(--grid-line); }
.theme-swiss .head::before { content:''; position:absolute; top:0; left:0; right:0; height:1rpx; background:var(--grid-line); z-index:1; pointer-events:none; }
.theme-swiss .body { border-left:1rpx solid var(--grid-line); }
.theme-swiss .head-day,.theme-swiss .head-corner { font-weight:700; }

.theme-swiss .period-index { font-family:var(--font-numeric); font-weight:700; font-size:34rpx; }
.theme-swiss .time-range { font-family:var(--font-numeric); font-size:21rpx; }
/* F: pixel rail/corners share the common course treatment. */
.theme-pixel { background:var(--page); border:4rpx solid transparent; border-image:var(--pixel-frame) 6 / 12rpx stretch; border-radius:0; padding:4rpx; }
.theme-pixel .head,.theme-pixel .body { border-radius:0; }
.theme-pixel .head-day,.theme-pixel .period-index { color:var(--accent); font-weight:700; }
.theme-pixel .head-corner { background-image:linear-gradient(45deg,transparent 48%,#8CBCEF 49%,#8CBCEF 51%,transparent 52%); }

.theme-pixel .period-index { font-family:var(--font-numeric); font-size:33rpx; }
.theme-pixel .time-range { font-family:var(--font-numeric); font-size:21rpx; font-weight:500; }

.theme-paper .card-name { font-family:var(--font-family); font-size:28rpx; font-weight:700; }
.theme-swiss .card { left:1rpx; right:1rpx; }
.theme-swiss .card-name,.theme-pixel .card-name { font-weight:700; }
.theme-pixel .card-name { font-size:28rpx; }
.theme-paper .card.single .card-name,.theme-pixel .card.single .card-name { font-size:25rpx; }
