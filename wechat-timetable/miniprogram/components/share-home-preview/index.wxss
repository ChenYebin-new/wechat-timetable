:host {
  display: block;
  min-height: 100vh;
}

.share-preview {
  min-height: 100vh;
  padding: 112rpx 64rpx 180rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background-color: var(--page);
  background-image: var(--page-texture);
  font-family: var(--font-family);
}

.share-preview-art {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius);
  padding: 44rpx;
  background: var(--soft);
}

.share-preview-title {
  margin-top: 42rpx;
  color: var(--text);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.share-preview-desc {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.55;
}
