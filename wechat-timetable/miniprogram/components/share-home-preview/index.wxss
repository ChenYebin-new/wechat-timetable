:host {
  display: block;
  min-height: 100vh;
}

.share-preview {
  min-height: 100vh;
  padding: 112rpx 64rpx 180rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #f2f5f7;
}

.share-preview-art {
  width: 300rpx;
  height: 300rpx;
  border-radius: 52rpx;
  box-shadow: 0 18rpx 42rpx rgba(24, 73, 69, 0.2);
}

.share-preview-title {
  margin-top: 42rpx;
  color: #213b36;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.share-preview-desc {
  margin-top: 16rpx;
  color: #4c625d;
  font-size: 26rpx;
  line-height: 1.55;
}
