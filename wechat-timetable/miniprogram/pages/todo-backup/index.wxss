@import "../data-manage/index.wxss";

.intro, .footnote {
  display: block;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.65;
  margin: 0 4rpx 24rpx;
}
.notice {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius);
  background: var(--soft);
  color: var(--accent);
  font-size: 26rpx;
  line-height: 1.6;
}
.error-box { margin: 0 0 24rpx; }
.row { gap: 20rpx; align-items: flex-start; }
.k { flex-shrink: 0; }
.v { min-width: 0; overflow-wrap: anywhere; text-align: right; }
.btn { min-height: 88rpx; white-space: normal; line-height: 1.5; padding: 22rpx 20rpx; }
.page button.btn[disabled] { color: var(--muted); background: var(--disabled); }
.input { font-size: 26rpx; }
.input::placeholder { color: var(--muted); }
.preview-card .error-line { margin-top: 16rpx; }

.page { min-height: 0; padding-top: 22rpx; }
