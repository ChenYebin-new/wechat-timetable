<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="待办与随想备份" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <text class="intro">备份所有日期的目标与随想，不包含课表。</text>
  <view wx:if="{{draftDate}}" class="notice" aria-role="alert">
    <text>{{draftDate}} 有尚未保存的编辑。导出只包含已保存内容；恢复前请先保存或放弃修改。</text>
    <button class="pressable btn btn-secondary" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onReturnToTodo">返回待办处理</button>
  </view>
  <view wx:if="{{writeProblem}}" class="error-box" aria-role="alert"><text class="error-line">{{writeProblem}}</text></view>
  <view wx:if="{{problem}}" class="error-box" aria-role="alert"><text class="error-line">{{problem}}</text></view>

  <view class="card">
    <view class="backup-heading"><image class="backup-icon icon-export" src="{{appearanceIcons.backupExport}}" aria-hidden="true" /><text class="card-title">导出备份</text></view>
    <text class="card-desc">复制后请妥善保存，备份包含已保存的个人记录。</text>
    <button class="pressable btn btn-primary" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onExport" disabled="{{busy || !!writeProblem}}">复制备份文本</button>
  </view>

  <view class="card">
    <view class="backup-heading"><image class="backup-icon icon-import" src="{{appearanceIcons.backupImport}}" aria-hidden="true" /><text class="card-title">导入备份</text></view>
    <text class="card-desc">粘贴完整备份并预览；恢复将替换所有日期的目标与随想。</text>
    <textarea class="input" value="{{inputText}}" bindinput="onInput" maxlength="-1" disabled="{{busy}}" placeholder="粘贴完整的待办与随想备份" aria-label="待办与随想备份文本" cursor-spacing="32" />
    <button class="pressable btn btn-secondary" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onParse" disabled="{{busy || !inputText || !!writeProblem}}">解析并预览</button>
  </view>

  <view class="card">
    <view class="backup-heading"><image class="backup-icon icon-recent" src="{{appearanceIcons.backupRecent}}" aria-hidden="true" /><text class="card-title">恢复前备份</text></view>
    <text class="card-desc">只保留最近一次恢复前的数据。恢复它时，也会先备份当前记录，方便撤回。</text>
    <block wx:if="{{recent}}">
      <view class="row"><text class="k">备份时间</text><text class="v">{{recent.exportedAt}}</text></view>
      <view class="row"><text class="k">记录</text><text class="v">{{recent.itemCount}} 个目标 · {{recent.noteCount}} 篇随想</text></view>
      <view class="row"><text class="k">日期范围</text><text class="v">{{recent.dateRange}}</text></view>
      <button class="pressable btn btn-secondary" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onPreviewRecent" disabled="{{busy || !!writeProblem}}">预览最近备份</button>
    </block>
    <text wx:elif="{{recentProblem}}" class="error-line" aria-role="alert">{{recentProblem}}</text>
    <view wx:else class="backup-empty"><image wx:if="{{themeId === 'campus' || themeId === 'paper'}}" src="{{appearanceIcons.backupEmpty}}" aria-hidden="true" /><text class="empty-title">暂无备份</text><text class="card-desc">首次覆盖恢复前，会保留当前数据。</text></view>
  </view>

  <view wx:if="{{preview}}" class="card preview-card">
    <text class="card-title">{{previewSource === 'recent' ? '最近备份预览' : '导入预览'}}</text>
    <view class="row"><text class="k">导出时间</text><text class="v">{{preview.exportedAt}}</text></view>
    <view class="row"><text class="k">数据版本</text><text class="v">V3</text></view>
    <view class="row"><text class="k">目标</text><text class="v">{{preview.itemCount}} 个 · 已完成 {{preview.completedCount}} 个</text></view>
    <view class="row"><text class="k">随想</text><text class="v">{{preview.noteCount}} 篇</text></view>
    <view class="row"><text class="k">日期范围</text><text class="v">{{preview.dateRange}}</text></view>
    <view class="row"><text class="k">将替换本机</text><text class="v">{{currentItemCount}} 个目标 · {{currentNoteCount}} 篇随想</text></view>
    <text wx:if="{{preview.itemCount === 0 && preview.noteCount === 0}}" class="error-line">这是空备份，恢复会清空全部已保存目标与随想。</text>
    <text wx:if="{{draftDate}}" class="error-line">请先返回待办处理未保存内容，再恢复。</text>
    <button class="pressable btn btn-danger" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onRestore" loading="{{busy}}" disabled="{{busy || !!draftDate || !!writeProblem}}">{{previewSource === 'recent' ? '恢复最近备份' : '覆盖待办与随想'}}</button>
  </view>
  <text class="footnote">最近备份仅存于本机。跨设备保留，请复制备份文本并另存。</text>
</view>
</block>
