/* pages/timetable/index.wxss
   说明：整页滚动 + 顶部概览吸顶(sticky)。概览为一条文字 + 右侧两个小按钮(用 view 精确控制尺寸)。 */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.overview {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  background: #dcecea;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.08);
  transform: translateZ(0);
}

.overview-text {
  font-size: 27rpx;
  font-weight: 700;
  color: #213b36;
  line-height: 1.4;
}

.overview-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.action-btn {
  height: 56rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #267d78;
  background: #e8f3f1;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.action-primary {
  color: #ffffff;
  background: #267d78;
}

.grid-scroll {
  padding: 0;
}

.grid-frame {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.empty-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.06);
}

.empty-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.empty-title {
  color: #2f4641;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 4rpx;
  color: #71837e;
  font-size: 21rpx;
}

.empty-btn {
  height: 52rpx;
  padding: 0 24rpx;
  margin: 0 0 0 16rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #267d78;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  background: #e8f3f1;
  border-radius: 26rpx;
}
