.page { padding:8rpx 24rpx calc(150rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.schedule-toolbar { display:flex; align-items:center; justify-content:space-between; gap:8rpx; margin-bottom:18rpx; }
.term-label { display:flex; align-items:center; gap:6rpx; flex:0 1 auto; min-width:0; min-height:44px; font-size:27rpx; line-height:1.4; white-space:nowrap; }
.term-text { min-width:0; overflow:hidden; text-overflow:ellipsis; }
.tool-button { display:flex; align-items:center; justify-content:center; width:104rpx; min-width:48px; min-height:44px; flex-shrink:0; color:var(--text); font-size:26rpx; line-height:1; white-space:nowrap; }
/* The compact visual face sits inside a full 44px touch target. */
.tool-face { display:flex; align-items:center; justify-content:center; gap:6rpx; width:100%; height:36px; box-sizing:border-box; border:1rpx solid var(--border); border-radius:16rpx; background:var(--surface); }
.tool-face image { width:30rpx; height:30rpx; flex-shrink:0; }
.tool-settings { order:2; }
.tool-add { order:3; }
.tool-add .tool-face { background:var(--primary); border-color:transparent; color:var(--on-primary); }
.tool-term { order:4; }
.plus-icon { position:relative; width:24rpx; height:24rpx; flex-shrink:0; }
.plus-icon::before,.plus-icon::after { position:absolute; content:''; background:currentColor; border-radius:1rpx; }
.plus-icon::before { top:11rpx; left:0; width:24rpx; height:2rpx; }
.plus-icon::after { left:11rpx; top:0; width:2rpx; height:24rpx; }
.week-bar { position:relative; display:flex; align-items:center; flex:0 0 calc(88px + 100rpx); min-width:132px; order:1; min-height:44px; }
.week-bar::before { content:''; position:absolute; left:0; right:0; top:4px; bottom:4px; background:var(--soft); border-radius:36px; pointer-events:none; }
.week-nav { position:relative; display:flex; align-items:center; justify-content:center; width:44px; min-width:44px; min-height:44px; flex-shrink:0; }
.week-chevron { width:12rpx; height:12rpx; border-top:2rpx solid currentColor; border-right:2rpx solid currentColor; }
.week-chevron.previous { transform:rotate(-135deg); }
.week-chevron.next { transform:rotate(45deg); }
.week-nav.disabled { opacity:.35; }
.week-bar picker { position:relative; flex:1; min-width:44px; }
.week-label { display:flex; align-items:center; justify-content:center; gap:6rpx; white-space:nowrap; font-size:26rpx; font-weight:600; min-height:44px; }
.down-mark { width:9rpx; height:9rpx; flex-shrink:0; border-bottom:2rpx solid currentColor; border-right:2rpx solid currentColor; transform:rotate(45deg); margin-top:-5rpx; }
.theme-cream .week-bar::before { left:4px; right:4px; }
.theme-campus .schedule-toolbar { gap:12rpx; margin-bottom:12rpx; }
.theme-campus .tool-button { width:120rpx; }
.theme-campus .tool-settings { order:0; }
.theme-campus .week-bar { flex:1; }
.theme-campus .week-bar::before { background:var(--surface); border:1rpx solid var(--border); border-radius:36px; }
.theme-campus .tool-face { border-color:transparent; border-radius:22rpx; }
.theme-campus .tool-add .tool-face { color:var(--text); background:var(--surface); }
.theme-campus .plus-icon { color:#E2A218; }
.theme-campus .plus-icon::before { height:5rpx; top:10rpx; }
.theme-campus .plus-icon::after { width:5rpx; left:10rpx; }
.actions-disabled,.week-bar-disabled { opacity:.48; }
.term-banner { display:flex; align-items:center; gap:20rpx; padding:20rpx; margin:12rpx 0; border-radius:18rpx; background:var(--warning-soft); color:var(--warning); }
.term-banner-text { flex:1; min-width:0; font-size:24rpx; line-height:1.5; }
.term-banner-btn { display:flex; align-items:center; min-height:44px; padding:0 18rpx; border-radius:14rpx; background:var(--warning); color:var(--on-dark); font-size:24rpx; }
.week-swiper,.week-static,.grid-frame { width:100%; }
.week-status,.selection-hint { display:block; text-align:center; font-size:22rpx; color:var(--muted); line-height:1.5; margin-top:12rpx; }
.week-status { color:var(--warning); }
.empty-notice { display:flex; align-items:center; gap:20rpx; padding:20rpx; margin-bottom:16rpx; background:var(--surface); border:1rpx solid var(--border); border-radius:18rpx; }
.empty-copy { flex:1; display:flex; flex-direction:column; gap:8rpx; }
.empty-title { font-weight:600; font-size:28rpx; }
.empty-desc { color:var(--muted); font-size:23rpx; line-height:1.5; }
.empty-btn { display:flex; align-items:center; min-height:44px; padding:0 16rpx; background:var(--soft); color:var(--accent); border-radius:16rpx; font-size:24rpx; }
.page.selecting { padding-bottom:calc(296rpx + env(safe-area-inset-bottom)); }
.selection-bar { position:fixed; left:22rpx; right:22rpx; bottom:calc(130rpx + env(safe-area-inset-bottom)); z-index:30; display:flex; align-items:center; gap:16rpx; min-height:116rpx; box-sizing:border-box; padding:16rpx; color:var(--on-dark); background:var(--selection-bar); border-radius:24rpx; }
.selection-copy { flex:1; min-width:0; display:flex; flex-direction:column; gap:6rpx; }
.selection-title { font-size:24rpx; font-weight:600; }
.selection-detail { color:var(--selection-muted); font-size:20rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.selection-actions { display:flex; align-items:center; gap:10rpx; }
.selection-cancel,.selection-next { display:flex; align-items:center; justify-content:center; min-height:44px; padding:0 18rpx; border-radius:16rpx; font-size:24rpx; }
.selection-cancel { background:rgba(255,255,255,.12); }
.selection-next { background:var(--surface); color:var(--accent); font-weight:600; }

.theme-paper .schedule-toolbar { gap:6rpx; flex-wrap:wrap; }
.theme-paper .term-label { font-size:25rpx; flex:1 1 220rpx; border-bottom:2rpx solid var(--accent); order:0; }
.theme-paper .week-bar { flex:1 1 220rpx; order:1; }.theme-paper .week-bar::before { background:transparent; border-radius:0; border-bottom:2rpx solid var(--accent); left:30rpx; right:30rpx; }
.theme-paper .tool-button { width:102rpx; }.theme-paper .tool-face { border-radius:6rpx; background:transparent; font-size:23rpx; }
.theme-paper .tool-add .tool-face { background:var(--primary); color:white; }.theme-paper .tool-term { order:4; }
.theme-paper .week-label { font-size:27rpx; font-weight:600; }
.theme-swiss .schedule-toolbar { flex-wrap:wrap; gap:10rpx; margin-bottom:4rpx; }
.theme-swiss .term-label { flex:1 1 230rpx; order:0; font-size:28rpx; font-weight:600; align-self:flex-start; }
.theme-swiss .term-label .down-mark { display:none; }
.theme-swiss .tool-button { width:122rpx; }.theme-swiss .tool-face { border:1rpx solid #555; border-radius:0; font-size:24rpx; background:white; }
.theme-swiss .tool-settings { order:1; }.theme-swiss .tool-add { order:2; }.theme-swiss .tool-term { order:3; }
.theme-swiss .tool-add .tool-face { color:var(--text); }.theme-swiss .tool-face image { display:none; }
.theme-swiss .week-bar { order:4; flex:1 0 100%; min-height:146rpx; }
.theme-swiss .week-bar::before { display:none; }.theme-swiss .week-nav { align-self:flex-end; }
.theme-swiss .week-nav:first-child { width:32rpx; min-width:44px; }
.theme-swiss .week-label { justify-content:flex-start; align-items:flex-end; min-height:125rpx; padding-bottom:14rpx; box-sizing:border-box; font-size:28rpx; }
.week-display { font-size:146rpx; line-height:1; font-weight:900; color:#090909; letter-spacing:-7rpx; margin:0 18rpx 0 -12rpx; font-family:var(--font-numeric); }
.theme-pixel .schedule-toolbar { gap:10rpx; }
.theme-pixel .tool-settings { order:0; }.theme-pixel .week-bar { flex:1; }
.theme-pixel .week-bar::before { border:6rpx solid transparent; border-image:var(--pixel-frame) 6 / 12rpx stretch; border-radius:0; background:white; top:1px; bottom:1px; }
.theme-pixel .tool-button { width:120rpx; color:var(--accent); }.theme-pixel .tool-face { background:white; border:2rpx solid var(--accent); border-radius:0; font-weight:600; }
.theme-pixel .tool-add .tool-face { background:white; color:var(--accent); }.theme-pixel .week-label { color:var(--accent); font-size:28rpx; }
.theme-pixel .selection-hint { color:var(--accent); font-size:22rpx; font-weight:500; }
@media (min-width:390px) { .theme-paper .schedule-toolbar { flex-wrap:nowrap; }.theme-paper .term-label { flex:1 1 auto; min-width:168rpx; }.theme-paper .week-bar { flex:0 0 calc(88px + 66rpx); min-width:116px; }.theme-paper .tool-button { width:90rpx; min-width:44px; }.theme-paper .tool-face { font-size:22rpx; gap:3rpx; }.theme-paper .tool-face image { width:24rpx; height:24rpx; } }
@media (max-width:389px) { .theme-paper .term-label { flex-basis:45%; }.theme-paper .week-bar { flex-basis:45%; }.theme-paper .tool-button { flex:1; }.theme-swiss .term-label { flex-basis:100%; }.theme-swiss .tool-button { flex:1; } }

.theme-paper .term-text { font-weight:700; }.theme-paper .week-label { letter-spacing:1rpx; }
.theme-swiss .week-label { font-variant-numeric:tabular-nums; }

/* Keep the full term and 44px controls on small phones; rpx must not shrink targets. */
@media (max-width:360px) {
  .theme-cream .schedule-toolbar,
  .theme-campus .schedule-toolbar,
  .theme-pixel .schedule-toolbar { flex-wrap:wrap; gap:8rpx; }
  .theme-cream .term-label { flex:1; min-width:120px; }
  .theme-cream .week-bar { flex:0 0 144px; }
  .theme-campus .week-bar,
  .theme-pixel .week-bar { flex:1 0 100%; order:0; }
  .theme-cream .tool-button,
  .theme-campus .tool-button,
  .theme-pixel .tool-button { flex:1; order:2; }
}
.week-label { font-variant-numeric:tabular-nums; }
