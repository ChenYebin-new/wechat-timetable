/* pages/timetable/index.wxss
   说明：整页滚动 + 顶部概览吸顶(sticky)。概览为一条文字 + 右侧两个小按钮的横栏。 */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.overview {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 0 16rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  background: #dcecea;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.08);
  transform: translateZ(0);
}

.overview-text {
  flex: 1 1 auto;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #213b36;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 12rpx;
}

.overview-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.data-entry {
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #267d78;
  background: #e8f3f1;
  border-radius: 26rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}

.data-entry::after {
  border: 0;
}

.quick-add {
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffffff;
  background: #267d78;
  border-radius: 26rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}

.quick-add::after {
  border: 0;
}

.grid-scroll {
  padding: 0;
}

.grid-frame {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.empty-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.06);
}

.empty-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.empty-title {
  color: #2f4641;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 4rpx;
  color: #71837e;
  font-size: 21rpx;
}

.empty-btn {
  height: 52rpx;
  min-height: 52rpx;
  margin: 0 0 0 16rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  color: #267d78;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  background: #e8f3f1;
  border-radius: 26rpx;
}

.empty-btn::after {
  border: 0;
}
