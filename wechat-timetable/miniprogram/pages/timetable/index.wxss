/* pages/timetable/index.wxss
   说明：页面整体滚动，顶部概览吸顶(sticky)，避免内层 scroll-view 裁切内容或头部位移导致闪烁。 */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.overview {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 12rpx 20rpx 12rpx 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
  background: #dcecea;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 83, 77, 0.1);
  transform: translateZ(0);
}

.overview-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}

.overview-title {
  color: #213b36;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.overview-meta {
  margin-top: 6rpx;
  color: #58706a;
  font-size: 23rpx;
  line-height: 1.3;
}

.overview-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.data-entry {
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #267d78;
  background: #e8f3f1;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.data-entry::after {
  border: 0;
}

.quick-add {
  height: 64rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffffff;
  background: #267d78;
  border-radius: 32rpx;
  line-height: 1;
}

.quick-add::after {
  border: 0;
}

.add-symbol {
  position: relative;
  width: 20rpx;
  height: 20rpx;
  margin-right: 8rpx;
}

.add-symbol::before,
.add-symbol::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 20rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #ffffff;
  transform: translate(-50%, -50%);
}

.add-symbol::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.quick-add-text {
  font-size: 23rpx;
  font-weight: 600;
}

.grid-scroll {
  padding: 0;
}

.grid-frame {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.empty-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 18rpx 18rpx 22rpx;
  margin-bottom: 16rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 83, 77, 0.06);
}

.empty-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.empty-title {
  color: #2f4641;
  font-size: 25rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 6rpx;
  color: #71837e;
  font-size: 22rpx;
}

.empty-btn {
  height: 64rpx;
  min-height: 64rpx;
  margin: 0 0 0 18rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  color: #267d78;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  background: #e8f3f1;
  border-radius: 32rpx;
}

.empty-btn::after {
  border: 0;
}
