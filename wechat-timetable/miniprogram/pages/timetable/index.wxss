/* pages/timetable/index.wxss
   说明：整页滚动 + 顶部概览吸顶(sticky)。概览为一条文字 + 右侧两个小按钮(用 view 精确控制尺寸)。 */
.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
}

.overview {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  background: #dcecea;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.08);
  transform: translateZ(0);
}

.overview-text {
  font-size: 27rpx;
  font-weight: 700;
  color: #213b36;
  line-height: 1.4;
}

.overview-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.page.selecting {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.actions-disabled,
.week-bar-disabled {
  opacity: 0.46;
}

.action-btn {
  flex: 1;
  height: 56rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  color: #267d78;
  background: #e8f3f1;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}

.action-primary {
  color: #ffffff;
  background: #267d78;
}

.term-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx 16rpx 22rpx;
  margin-bottom: 12rpx;
  background: #fdf3e7;
  border-radius: 14rpx;
}

.term-banner-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #8a6a3f;
  line-height: 1.4;
}

.term-banner-btn {
  flex-shrink: 0;
  margin-left: 14rpx;
  height: 52rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #c98a2b;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}

.week-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.06);
}

.week-nav {
  width: 60rpx;
  height: 52rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #e8f3f1;
  color: #267d78;
  font-size: 34rpx;
  font-weight: 700;
}

.week-nav.disabled {
  opacity: 0.35;
}

.week-bar picker {
  flex: 1;
}

.week-label {
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #213b36;
}

.term-edit {
  flex-shrink: 0;
  height: 52rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #f5f8f8;
  color: #58706a;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
}

.week-status {
  margin: 0 4rpx 12rpx;
  font-size: 22rpx;
  color: #9a5b13;
}

.selection-hint {
  margin: 0 4rpx 12rpx;
  color: #64756f;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}

.selection-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  box-sizing: border-box;
  color: #ffffff;
  background: #1f4f49;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgba(31, 79, 73, 0.28);
}

.selection-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selection-title {
  font-size: 25rpx;
  font-weight: 700;
}

.selection-detail {
  overflow: hidden;
  color: #d7ebe7;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selection-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.selection-cancel,
.selection-next {
  height: 64rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 32rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.selection-cancel {
  color: #d7ebe7;
  background: rgba(255, 255, 255, 0.12);
}

.selection-next {
  color: #17443f;
  background: #f4fbf9;
}

.grid-scroll {
  padding: 0 0 calc(28rpx + env(safe-area-inset-bottom));
}

.week-swiper,
.grid-frame {
  width: 100%;
}

.empty-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #ffffff;
  border-radius: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.06);
}

.empty-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.empty-title {
  color: #2f4641;
  font-size: 24rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 4rpx;
  color: #71837e;
  font-size: 21rpx;
}

.empty-btn {
  height: 52rpx;
  padding: 0 24rpx;
  margin: 0 0 0 16rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #267d78;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1;
  background: #e8f3f1;
  border-radius: 26rpx;
}
