<!-- pages/timetable/index.wxml -->
<view class="page">
  <view class="overview">
    <text class="overview-text">{{overviewText}}</text>
    <view class="overview-actions">
      <button class="data-entry" bindtap="onDataManage" aria-label="数据管理">数据</button>
      <button class="quick-add" bindtap="onAdd" aria-label="新增课程">＋ 新增</button>
    </view>
  </view>

  <view wx:if="{{isEmpty}}" class="empty-notice">
    <view class="empty-copy">
      <text class="empty-title">课表还是空的</text>
      <text class="empty-desc">先添加第一门课程，周课表会立即显示。</text>
    </view>
    <button class="empty-btn" bindtap="onAdd">开始添加</button>
  </view>

  <view class="grid-scroll">
    <view class="grid-frame">
      <timetable-grid day-slots="{{daySlots}}" bind:cardtap="onCourseTap" />
    </view>
  </view>
</view>
