.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rule-card,
.count-card,
.period-card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: none;
}

.rule-card,
.period-card {
  padding: 0 26rpx;
}

.count-card {
  min-height: 112rpx;
  padding: 0 26rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rule-row,
.period-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.period-value {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.period-time {
  white-space: nowrap;
}

.custom-badge {
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  color: var(--accent);
  background: var(--soft);
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}

.chevron {
  color: var(--muted);
  font-size: 42rpx;
  font-weight: 300;
}

.divider {
  height: 2rpx;
  background: var(--border);
}

.helper {
  margin: 14rpx 6rpx 0;
  color: var(--muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.stepper {
  height: 64rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-small);
}

.step-btn,
.step-value {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.step-btn {
  color: var(--accent);
  background: var(--soft);
  font-size: 34rpx;
}

.step-btn.disabled {
  color: var(--muted);
}

.step-value {
  border-right: 2rpx solid var(--border);
  border-left: 2rpx solid var(--border);
  color: var(--text);
  font-size: 27rpx;
  font-weight: 600;
}

.regenerate {
  min-height: 84rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  background: var(--soft);
  border-radius: var(--radius-small);
  font-size: 25rpx;
  font-weight: 600;
}

.save-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: var(--page);
}

.save-btn {
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}

.save-btn-pressed {
  background: var(--primary);
  transform: scale(0.98);
}

.rule-card,.count-card,.period-card { border: 1rpx solid var(--border); }
.stepper { height: auto; }
.step-btn,.step-value { width: 44px; min-height: 44px; height: auto; }
.regenerate,.save-btn { min-height: 44px; }

.page { min-height: 0; padding-top: 22rpx; }
