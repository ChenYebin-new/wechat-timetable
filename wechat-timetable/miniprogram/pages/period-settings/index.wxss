.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rule-card,
.count-card,
.period-card {
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: none;
}

.rule-card,
.period-card {
  padding: 0 26rpx;
}

.count-card {
  min-height: 112rpx;
  padding: 0 26rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rule-row,
.period-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.period-value {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.period-time {
  white-space: nowrap;
}

.custom-badge {
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
  color: var(--accent);
  background: var(--soft);
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}

.chevron {
  color: var(--muted);
  font-size: 42rpx;
  font-weight: 300;
}

.divider {
  height: 2rpx;
  background: var(--border);
}

.helper {
  margin: 14rpx 6rpx 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.stepper {
  height: 64rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-small);
}

.step-btn,
.step-value {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.step-btn {
  color: var(--accent);
  background: var(--soft);
  font-size: 34rpx;
}

.step-btn.disabled {
  color: var(--muted);
}

.step-value {
  border-right: 2rpx solid var(--border);
  border-left: 2rpx solid var(--border);
  color: var(--text);
  font-size: 27rpx;
  font-weight: 600;
}

.regenerate {
  min-height: 84rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  background: var(--soft);
  border-radius: var(--radius-small);
  font-size: 25rpx;
  font-weight: 600;
}

.save-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: var(--page);
}

.save-btn {
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}

.save-btn-pressed {
  background: var(--primary);
  transform: scale(0.98);
}

.rule-card,.count-card,.period-card { border: 1rpx solid var(--border); }
.stepper { height: auto; }
.step-btn,.step-value { width: 44px; min-height: 44px; height: auto; }
.regenerate,.save-btn { min-height: 44px; }

.page { min-height: 0; padding-top: 22rpx; }

.page.theme-aqua { padding:18rpx 22rpx calc(170rpx + env(safe-area-inset-bottom)); }
.theme-aqua .rule-card,.theme-aqua .period-card { padding:0 28rpx; }
.theme-aqua .rule-row,.theme-aqua .period-row { min-height:116rpx; }
.theme-aqua .row-title { font-size:29rpx; font-weight:500; }
.theme-aqua .row-value,.theme-aqua .period-value { color:var(--text); }
.theme-aqua .divider { height:1rpx; }
.theme-aqua .count-card { padding:18rpx 28rpx; min-height:124rpx; }
.theme-aqua .stepper { border:0; background:var(--input); border-radius:22rpx; }
.theme-aqua .step-btn { background:var(--soft); }
.theme-aqua .step-value { border:0; }
.theme-aqua .custom-badge { background:var(--soft); border-radius:8rpx; font-size:20rpx; }
.theme-aqua .regenerate { min-height:48px; border-radius:24rpx; background:rgba(255,255,255,.75); font-weight:500; }
.theme-aqua .save-area { left:22rpx; right:22rpx; padding-top:28rpx; background:linear-gradient(180deg,rgba(255,255,255,0),#FFFFFF 30%); }
.theme-aqua .chevron { width:12rpx; height:12rpx; margin:0 5rpx 0 10rpx; border-right:2rpx solid var(--muted); border-top:2rpx solid var(--muted); transform:rotate(45deg); font-size:0; flex-shrink:0; }
@media (max-width:360px) {
  .theme-aqua .period-row { gap:12rpx; }
  .theme-aqua .period-value { flex-wrap:wrap; gap:8rpx; }
  .theme-aqua .period-time { font-size:24rpx; }
}
.theme-aqua .rule-row,.theme-aqua .save-btn { transition:opacity 120ms ease-out; }
.theme-aqua .rule-row.aqua-picker-pressed { opacity:.84; }
.theme-aqua .save-btn.save-btn-pressed { transform:none; opacity:.84; }
@media (prefers-reduced-motion:reduce) {
  .theme-aqua .rule-row,.theme-aqua .save-btn { transition:none; }
}
