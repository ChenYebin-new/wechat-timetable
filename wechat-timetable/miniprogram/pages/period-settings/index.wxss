.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.rule-card,
.count-card,
.period-card {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 83, 77, 0.06);
}

.rule-card,
.period-card {
  padding: 0 26rpx;
}

.count-card {
  min-height: 112rpx;
  padding: 0 26rpx;
  margin: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rule-row,
.period-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.row-title {
  color: #263d38;
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  color: #71837e;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.chevron {
  color: #a5b2ae;
  font-size: 42rpx;
  font-weight: 300;
}

.divider {
  height: 2rpx;
  background: #eef2f1;
}

.helper {
  margin: 14rpx 6rpx 0;
  color: #71837e;
  font-size: 21rpx;
  line-height: 1.5;
}

.stepper {
  height: 64rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border: 2rpx solid #d8e3e0;
  border-radius: 12rpx;
}

.step-btn,
.step-value {
  width: 72rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.step-btn {
  color: #267d78;
  background: #f5faf9;
  font-size: 34rpx;
}

.step-btn.disabled {
  color: #b8c4c1;
}

.step-value {
  border-right: 2rpx solid #d8e3e0;
  border-left: 2rpx solid #d8e3e0;
  color: #263d38;
  font-size: 27rpx;
  font-weight: 600;
}

.regenerate {
  min-height: 84rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #267d78;
  background: #e8f3f1;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.save-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 0 calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to bottom, rgba(242, 245, 247, 0), #f2f5f7 28rpx);
}

.save-btn {
  border-radius: 44rpx;
  background: #267d78;
  color: #ffffff;
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}

.save-btn-pressed {
  background: #1d5f5b;
  transform: scale(0.98);
}
