<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="设置" subtitle="外观、学期、备份与反馈。" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view wx:if="{{themeId === 'cream'}}" class="intro">
    <text class="intro-desc">调整外观与课程时间，备份数据或反馈问题。</text>
  </view>

  <view class="menu-card">
    <view class="menu-row menu-appearance" hover-class="menu-pressed" bindtap="onAppearance" aria-role="button" aria-label="外观，当前{{appearanceName}}">
      <image class="menu-icon" src="{{appearanceIcons.menuAppearance}}" aria-hidden="true" />
      <view class="menu-copy"><text class="menu-title">外观</text><text class="menu-desc">{{appearanceName}} · 课程自动配色</text></view>
      <text class="chevron">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-row menu-term" hover-class="menu-pressed" bindtap="onTermSettings" aria-role="button" aria-label="学期设置">
      <image class="menu-icon" src="{{appearanceIcons.menuTerm}}" aria-hidden="true" />
      <view class="menu-copy">
        <text class="menu-title">学期设置</text>
        <text class="menu-desc">第一教学周、总周数</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-row menu-time" hover-class="menu-pressed" bindtap="onPeriodSettings" aria-role="button" aria-label="课程时间设置">
      <image class="menu-icon" src="{{appearanceIcons.menuTime}}" aria-hidden="true" />
      <view class="menu-copy">
        <text class="menu-title">课程时间设置</text>
        <text class="menu-desc">每日节数、课时时长和具体时间</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-row menu-data" hover-class="menu-pressed" bindtap="onDataManage" aria-role="button" aria-label="课表数据管理">
      <image class="menu-icon" src="{{appearanceIcons.menuData}}" aria-hidden="true" />
      <view class="menu-copy">
        <text class="menu-title">课表数据管理</text>
        <text class="menu-desc">导出、导入与最近自动备份</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-row menu-backup" hover-class="menu-pressed" bindtap="onTodoBackup" aria-role="button" aria-label="待办与随想备份">
      <image class="menu-icon" src="{{appearanceIcons.menuBackup}}" aria-hidden="true" />
      <view class="menu-copy">
        <text class="menu-title">待办与随想备份</text>
        <text class="menu-desc">备份与恢复每日记录</text>
      </view>
      <text class="chevron">›</text>
    </view>
    <view class="divider"></view>
    <view class="menu-row menu-about" hover-class="menu-pressed" bindtap="onAbout" aria-role="button" aria-label="关于我们，联系开发者与意见反馈">
      <image class="menu-icon" src="{{appearanceIcons.brand}}" aria-hidden="true" />
      <view class="menu-copy">
        <text class="menu-title">关于我们</text>
        <text class="menu-desc">联系开发者与意见反馈</text>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
  <view wx:if="{{themeId === 'paper'}}" class="paper-signoff" aria-hidden="true"><view class="paper-signoff-art"><image src="{{appearanceIcons.brand}}" /><image class="sprig" src="/assets/appearance/paper-sprig.png" /></view><text>把生活整理好，</text><text>也是一种向前。</text></view>
  <view wx:if="{{themeId === 'pixel'}}" class="pixel-signoff" aria-hidden="true"><view class="pixel-spark" /><text>好好学习　天天向上</text></view>
  <view wx:if="{{themeId === 'campus'}}" class="campus-signoff" aria-hidden="true">
    <image src="/assets/appearance/campus-book.png" mode="aspectFit" />
    <view class="signoff-copy"><text>好好学习</text><text>天天向上</text><view class="signoff-line" /></view>
  </view>
</view>
</block>
