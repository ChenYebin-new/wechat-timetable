.page { padding:24rpx 26rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing:border-box; }
.about-intro { margin:4rpx 4rpx 34rpx; }
.brand-heading { display:flex; align-items:center; gap:18rpx; }
.brand-icon { width:64rpx; height:64rpx; flex-shrink:0; }
.brand-title { font-size:36rpx; line-height:1.4; font-weight:700; }
.intro-desc { display:block; margin-top:16rpx; color:var(--muted); font-size:28rpx; line-height:1.65; }
.card { margin-bottom:24rpx; padding:26rpx; border:1rpx solid var(--border); border-radius:var(--card-radius); background:var(--surface); }
.card-title { display:block; color:var(--text); font-size:30rpx; line-height:1.5; font-weight:700; }
.card-desc { display:block; margin-top:12rpx; color:var(--muted); font-size:26rpx; line-height:1.65; }
.email-address { display:block; margin:16rpx 0 24rpx; color:var(--text); font-size:30rpx; line-height:1.6; overflow-wrap:anywhere; word-break:break-all; }
.btn { display:flex; align-items:center; justify-content:center; width:100% !important; min-height:48px; margin:0; padding:20rpx 24rpx; box-sizing:border-box; border-radius:var(--radius-small); font-size:28rpx; line-height:1.5; }
.btn-primary { color:var(--on-primary); background:var(--primary); }
.btn::after,.qr-preview::after { border:0; }
.button-pressed { opacity:.8; }
.qr-preview { display:flex; flex-direction:column; align-items:center; min-height:44px; width:100% !important; padding:0; margin:24rpx 0 0; box-sizing:border-box; border-radius:0; background:transparent; line-height:1.5; }
.qr-image { display:block; width:500rpx; max-width:100%; background:#FFFFFF; }
.qr-caption { display:block; margin-top:16rpx; color:var(--muted); font-size:26rpx; }
.qr-error { color:var(--danger); }
.feedback-note { margin:32rpx 4rpx 0; }
.note-title { display:block; color:var(--text); font-size:26rpx; font-weight:600; line-height:1.5; }
