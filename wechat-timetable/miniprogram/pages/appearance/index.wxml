<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="外观" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="intro"><text class="intro-title">选择喜欢的外观</text><text class="intro-desc">先看预览，再点“使用此外观”。</text></view>
  <view class="theme-choices" aria-role="radiogroup" aria-label="选择外观">
    <button wx:for="{{choices}}" wx:key="id" class="theme-choice {{selectedTheme === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="onChoose" disabled="{{saving}}" aria-role="radio" aria-checked="{{selectedTheme === item.id}}" aria-label="{{item.name}}{{currentTheme === item.id ? '，当前使用' : ''}}" hover-class="choice-pressed">
      <view class="theme-thumbnail thumbnail-{{item.id}}" style="{{item.style}}">
        <image wx:if="{{item.art}}" class="thumbnail-art" src="{{item.art}}" mode="aspectFill" aria-hidden="true" />
        <view wx:if="{{item.id === 'aqua'}}" class="thumbnail-aqua-heading" aria-hidden="true"><view /><view /><view /></view>
        <view class="thumbnail-blocks" aria-hidden="true"><view wx:for="{{item.colors}}" wx:for-item="color" wx:key="slot" class="course-block course-{{item.id}}" style="background-color:{{color.background}};--course-accent:{{color.accent}}"><view class="course-rail" /></view></view>
      </view>
      <view class="choice-copy"><text class="choice-name">{{item.name}}</text><text class="choice-status">{{currentTheme === item.id ? '当前使用' : selectedTheme === item.id ? '待应用' : '预览'}}</text></view>
    </button>
  </view>
  <view class="preview-heading"><text class="section-title">{{selectedName}}</text><text class="sample-label">示例预览</text></view>
  <view class="preview-pair" style="{{previewStyle}}" aria-label="{{selectedName}}课表与待办示例预览，不含个人数据">
    <view class="mini-screen mini-theme-{{selectedTheme}}" aria-hidden="true">
      <view class="mini-masthead"><image wx:if="{{previewArt}}" class="mini-art" src="{{previewArt}}" mode="aspectFill" /><text class="mini-title">拾课课表</text></view>
      <view wx:if="{{selectedTheme === 'aqua'}}" class="mini-aqua-toolbar"><text>第4周</text><text class="mini-aqua-term">第一学期</text><image src="{{previewIcons.settings}}" /><view class="mini-aqua-plus" /></view>
      <text wx:else class="mini-week"><text wx:if="{{selectedTheme === 'swiss'}}" class="mini-week-number">04 </text>‹　 第 4 周　 ›</text>
      <view wx:if="{{selectedTheme === 'aqua'}}" class="mini-aqua-weekdays"><text class="mini-month">9月</text><view class="mini-day" wx:for="{{previewDays}}" wx:key="*this"><text>{{item}}</text><text class="mini-date {{index === 0 ? 'mini-today' : ''}}">{{previewDates[index]}}</text></view></view>
      <view wx:else class="mini-weekdays"><text wx:for="{{previewDays}}" wx:key="*this">{{item}}</text></view>
      <view class="mini-grid-shell">
        <view wx:if="{{selectedTheme === 'aqua'}}" class="mini-time-col"><text wx:for="{{previewRows}}" wx:key="*this">{{item}}</text></view>
        <view class="mini-grid"><view class="mini-row" wx:for="{{previewRows}}" wx:key="*this"></view><view class="mini-course course-block course-{{selectedTheme}}" wx:for="{{previewCourses}}" wx:key="id" style="{{item.style}}"><view class="course-rail" /><view wx:if="{{selectedTheme === 'pixel'}}" class="course-pixel-cap cap-top" /><view wx:if="{{selectedTheme === 'pixel'}}" class="course-pixel-cap cap-bottom" /><text>{{item.name}}</text><text class="mini-room">{{item.room}}</text></view></view>
      </view>
      <view class="mini-tabs"><view class="mini-tab mini-selected"><image wx:if="{{selectedTheme === 'aqua'}}" src="{{previewIcons.calendar}}" /><text>课表</text></view><view class="mini-tab"><image wx:if="{{selectedTheme === 'aqua'}}" src="{{previewIcons.neutralTodo}}" /><text>待办</text></view></view>
    </view>
    <view class="mini-screen mini-theme-{{selectedTheme}}" aria-hidden="true">
      <view class="mini-masthead"><image wx:if="{{previewArt}}" class="mini-art" src="{{previewArt}}" mode="aspectFill" /><text class="mini-title">待办</text></view><text class="mini-week">‹　9月28日　›</text>
      <view class="mini-section"><text class="mini-label">当日目标</text><view class="mini-goal"><view class="mini-check"></view><text>完成高数习题</text></view><view class="mini-goal"><view class="mini-check"></view><text>整理英语笔记</text></view><view class="mini-add">＋ 添加目标</view></view>
      <view class="mini-section"><text class="mini-label">随想记录</text><view class="mini-note">把难题拆成小步骤，<text>每天进步一点点。</text></view></view>
      <view class="mini-tabs"><view class="mini-tab"><image wx:if="{{selectedTheme === 'aqua'}}" src="{{previewIcons.neutralCalendar}}" /><text>课表</text></view><view class="mini-tab mini-selected"><image wx:if="{{selectedTheme === 'aqua'}}" src="{{previewIcons.todo}}" /><text>待办</text></view></view>
    </view>
  </view>
  <text class="appearance-note">课程自动配色；切换外观不会改变课程安排。</text>
  <text wx:if="{{problem}}" class="error-message" aria-role="alert">{{problem}}</text>
  <button class="pressable apply-button" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onApply" disabled="{{saving || selectedTheme === currentTheme}}" loading="{{saving}}" aria-label="{{selectedTheme === currentTheme ? '当前已使用此外观' : '使用' + selectedName + '外观'}}">{{selectedTheme === currentTheme ? '正在使用此外观' : '使用此外观'}}</button>
  <text class="local-note">仅保存在本机，课表与待办数据不变。</text>
</view>
</block>
