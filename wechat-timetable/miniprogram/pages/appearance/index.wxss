@import "../../styles/course-block.wxss";
.page { min-height: 100vh; padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.intro { margin: 4rpx 4rpx 28rpx; }
.intro-title { display: block; font-size: var(--font-title); font-weight: 700; line-height: 1.5; }
.intro-desc { display: block; margin-top: 12rpx; color: var(--muted); font-size: var(--font-small); line-height: 1.6; }
.theme-choices { display: flex; gap: 20rpx; }
.theme-choice { flex: 1; min-width: 0; margin: 0; padding: 0; overflow: hidden; text-align: left; border: 3rpx solid var(--border); border-radius: var(--radius); background: var(--surface); color: var(--text); line-height: 1.4; }
.theme-choice::after, .apply-button::after { border: none; }
.theme-choice.chosen { border-color: var(--accent); }
.choice-pressed { opacity: .8; }
.theme-thumbnail { height: 128rpx; background: var(--page); position: relative; padding: 30rpx 20rpx 18rpx; box-sizing: border-box; }
.thumbnail-art { position: absolute; inset: 0; width: 100%; height: 100%; }
.thumbnail-blocks { display: flex; gap: 10rpx; position: relative; align-items: flex-end; height: 100%; }
.thumbnail-blocks > .course-block { position:relative; width:42rpx; height:58rpx; }
.thumbnail-blocks > .course-block:nth-child(even) { height: 40rpx; }
.choice-copy { padding: 18rpx 20rpx; }
.choice-name { display: block; font-size: 30rpx; font-weight: 700; }
.choice-status { display: block; font-size: 24rpx; color: var(--muted); margin-top: 6rpx; }
.chosen .choice-status { color: var(--accent); }
.preview-heading { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 4rpx 18rpx; }
.section-title { font-size: 30rpx; font-weight: 700; }
.sample-label, .appearance-note, .local-note { font-size: 24rpx; color: var(--muted); line-height: 1.6; }
.preview-pair { display: flex; gap: 16rpx; }
.mini-screen { flex: 1; min-width: 0; background: var(--page); color: var(--text); border: 2rpx solid var(--border); border-radius: var(--radius); overflow: hidden; padding: 18rpx 12rpx 50rpx; position: relative; min-height: 450rpx; }
.mini-art { height: 74rpx; width: calc(100% + 24rpx); margin: -18rpx -12rpx 4rpx; }
.mini-title { display: block; font-size: 25rpx; font-weight: 700; margin: 4rpx 0 14rpx; }
.mini-week { display: block; background: var(--soft); border-radius: var(--radius-small); text-align: center; font-size: 20rpx; padding: 10rpx 0; margin-bottom: 10rpx; }
.mini-weekdays { display: flex; font-size: 16rpx; text-align: center; padding: 5rpx 0; }
.mini-weekdays text { flex: 1; }
.mini-grid { position: relative; }
.mini-row { height: 38rpx; box-sizing: border-box; border-bottom: 1rpx solid var(--border); }
.mini-course { position:absolute; width:14.285714%; height:74rpx; padding:6rpx 2rpx 6rpx 7rpx; font-size:15rpx; text-align:left; font-weight:600; }
.mini-course text { display: block; }
.mini-room { font-size: 12rpx; margin-top: 5rpx; }
.mini-section { margin-top: 18rpx; }
.mini-label { font-size: 21rpx; font-weight: 700; }
.mini-goal { display: flex; align-items: center; gap: 8rpx; padding: 15rpx 6rpx; margin-top: 8rpx; border-radius: 10rpx; background: var(--surface); font-size: 19rpx; }
.mini-check { width: 15rpx; height: 15rpx; border: 2rpx solid var(--muted); border-radius: 50%; flex-shrink: 0; }
.mini-add { margin-top: 10rpx; padding: 10rpx; text-align: center; color: var(--accent); background: var(--soft); border-radius: 10rpx; font-size: 19rpx; }
.mini-note { margin-top: 10rpx; padding: 14rpx 10rpx; background: var(--surface); border-radius: 10rpx; font-size: 18rpx; line-height: 1.7; min-height: 100rpx; }
.mini-note text { display: block; }
.mini-tabs { position: absolute; bottom: 0; left: 0; right: 0; height: 40rpx; background: var(--surface); display: flex; justify-content: space-around; align-items: center; color: var(--muted); font-size: 18rpx; }
.mini-selected { color: var(--accent); font-weight: 700; }
.appearance-note { display: block; margin: 20rpx 4rpx 28rpx; }
.apply-button { background: var(--primary); color: var(--on-primary); border-radius: var(--radius); min-height: 48px; font-size: 30rpx; font-weight: 600; }
.apply-button[disabled]:not([type]) { background: var(--disabled); color: var(--muted); }
.local-note { display: block; text-align: center; margin-top: 16rpx; }
.error-message { display: block; color: var(--danger); margin: 20rpx 0; font-size: 26rpx; }

.page { min-height: 0; padding-top: 22rpx; }

.mini-masthead { position:relative; margin:-18rpx -12rpx 12rpx; padding:18rpx 12rpx 2rpx; }
.mini-title { position:relative; }
.mini-theme-campus .mini-masthead { min-height:92rpx; padding-top:28rpx; box-sizing:border-box; }
.mini-art { position:absolute; inset:0; width:100%; height:100%; margin:0; }
.mini-theme-campus .mini-section { padding:12rpx; border-radius:14rpx; background:var(--surface); }
.mini-theme-campus .mini-note { background:var(--input); }
.theme-choices { flex-wrap:wrap; justify-content:space-between; gap:20rpx 0; }
.theme-choice { flex:0 0 48%; width:48% !important; margin:0 !important; box-sizing:border-box; }
.theme-thumbnail { height:112rpx; }
.thumbnail-paper { background-image:var(--page-texture); }

.thumbnail-pixel { border-bottom:2rpx solid var(--accent); }
.mini-screen { font-family:var(--font-family); }
.mini-theme-paper { background-image:var(--page-texture); }.mini-theme-paper .mini-goal,.mini-theme-paper .mini-note { border:1rpx solid var(--border); background:transparent; border-radius:3rpx; }
.mini-theme-paper .mini-title { text-align:center; }.mini-theme-paper .mini-week { background:transparent; border-bottom:1rpx solid var(--accent); }
.mini-theme-swiss .mini-title { font-size:30rpx; font-weight:900; }.mini-theme-swiss .mini-week { background:white; text-align:left; padding:0; }
.mini-week-number { font-size:48rpx; font-weight:900; }.mini-theme-swiss .mini-goal,.mini-theme-swiss .mini-note,.mini-theme-swiss .mini-add { border:1rpx solid #777; border-radius:0; background:white; }
.mini-theme-swiss .mini-tabs { border-top:1rpx solid #777; }
.mini-theme-pixel { border:3rpx solid var(--accent); }.mini-theme-pixel .mini-masthead { min-height:94rpx; }
.mini-theme-pixel .mini-art { left:auto; top:auto; right:0; bottom:0; width:60%; height:66rpx; }
.mini-theme-pixel .mini-title { color:var(--accent); font-weight:800; }.mini-theme-pixel .mini-week { background:white; border:2rpx solid var(--accent); }
.mini-theme-pixel .mini-section { padding:8rpx; border:2rpx solid var(--accent); }
.mini-theme-pixel .mini-note { border-radius:0; background:white; }.mini-theme-pixel .mini-tabs { border-top:1rpx solid var(--border); }

.thumbnail-blocks,.mini-grid { --course-rail-width:3rpx; --course-pixel-step:2rpx; --card-radius:4rpx; }
.mini-theme-paper .mini-grid { --card-radius:2rpx; }
.mini-theme-swiss .mini-grid,.mini-theme-pixel .mini-grid { --card-radius:0rpx; }

.thumbnail-aqua { padding:36rpx 14rpx 14rpx; background-color:var(--page); background-image:var(--page-texture); }
.thumbnail-aqua-heading { position:absolute; top:13rpx; left:16rpx; right:16rpx; display:flex; align-items:center; gap:10rpx; }
.thumbnail-aqua-heading view:first-child { width:48rpx; height:5rpx; background:#3D535E; border-radius:3rpx; margin-right:auto; }
.thumbnail-aqua-heading view:not(:first-child) { width:12rpx; height:12rpx; border-radius:50%; background:rgba(255,255,255,.9); }
.thumbnail-aqua .thumbnail-blocks { padding:12rpx 14rpx 0; gap:8rpx; background:#FFFFFF; border-radius:16rpx 16rpx 0 0; }
.thumbnail-aqua .thumbnail-blocks > .course-block { height:46rpx; border-radius:2rpx; }
.thumbnail-aqua .thumbnail-blocks > .course-block:nth-child(even) { height:32rpx; }
.thumbnail-aqua::after { content:''; position:absolute; bottom:5rpx; left:25%; right:25%; height:13rpx; border:3rpx solid #FFFFFF; border-radius:20rpx; background:linear-gradient(90deg,#E6FBFB 50%,#FFFFFF 50%); box-shadow:0 3rpx 10rpx rgba(73,107,123,.06); }
.mini-theme-aqua { padding:18rpx 10rpx 70rpx; background-color:var(--page); background-image:var(--page-texture); border:1rpx solid var(--border); border-radius:28rpx; }
.mini-theme-aqua .mini-masthead { margin:-18rpx -10rpx 10rpx; padding:22rpx 14rpx 2rpx; }
.mini-theme-aqua .mini-title { font-size:24rpx; font-weight:600; margin-bottom:10rpx; }
.mini-aqua-toolbar { display:flex; align-items:center; gap:8rpx; padding:12rpx 10rpx; background:rgba(255,255,255,.5); border:1rpx solid rgba(255,255,255,.9); border-bottom:0; border-radius:18rpx 18rpx 0 0; font-size:19rpx; font-weight:600; }
.mini-aqua-term { flex:1; min-width:0; font-size:13rpx; font-weight:400; color:var(--muted); }
.mini-aqua-toolbar image { width:24rpx; height:24rpx; }
.mini-aqua-plus { position:relative; width:26rpx; height:26rpx; border-radius:50%; background:#FFFFFF; }
.mini-aqua-plus::before,.mini-aqua-plus::after { content:''; position:absolute; left:6rpx; top:12rpx; width:14rpx; height:2rpx; background:var(--accent); }
.mini-aqua-plus::after { transform:rotate(90deg); }
.mini-aqua-weekdays { display:flex; align-items:center; padding:8rpx 0 12rpx; background:rgba(255,255,255,.5); border-left:1rpx solid rgba(255,255,255,.9); border-right:1rpx solid rgba(255,255,255,.9); }
.mini-month { width:24rpx; font-size:12rpx; text-align:center; }
.mini-day { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; gap:3rpx; font-size:15rpx; }
.mini-date { display:flex; align-items:center; justify-content:center; width:26rpx; height:26rpx; color:var(--muted); font-size:13rpx; }
.mini-today { border-radius:50%; background:linear-gradient(120deg,#DDFCE9,#CBEAFF); color:var(--text); }
.mini-theme-aqua .mini-grid-shell { display:flex; padding-top:4rpx; background:#FFFFFF; border-radius:16rpx 16rpx 0 0; overflow:hidden; }
.mini-time-col { width:24rpx; flex-shrink:0; }
.mini-time-col text { display:block; height:38rpx; padding-top:3rpx; box-sizing:border-box; text-align:center; font-size:13rpx; }
.mini-theme-aqua .mini-grid { flex:1; min-width:0; --card-radius:2rpx; }
.mini-theme-aqua .mini-row { border-bottom:1rpx dashed #D8D8DC; }
.mini-theme-aqua .mini-course { height:74rpx; padding-left:6rpx; font-size:14rpx; line-height:1.3; overflow:hidden; }
.mini-theme-aqua .mini-room { margin-top:4rpx; font-size:12rpx; font-weight:400; }
.mini-theme-aqua .mini-tabs { bottom:12rpx; left:16rpx; right:16rpx; height:48rpx; padding:5rpx; background:#FFFFFF; border-radius:40rpx; box-shadow:0 8rpx 30rpx rgba(55,80,96,.08); }
.mini-theme-aqua .mini-tab { display:flex; align-items:center; justify-content:center; gap:7rpx; flex:1; height:100%; border-radius:30rpx; font-size:18rpx; }
.mini-theme-aqua .mini-tab image { width:26rpx; height:26rpx; }
.mini-theme-aqua .mini-selected { color:var(--text); background:var(--soft); font-weight:600; }
.mini-theme-aqua .mini-week { background:rgba(255,255,255,.6); border:1rpx solid rgba(255,255,255,.9); border-radius:20rpx; color:var(--text); }
.mini-theme-aqua .mini-section { padding:16rpx 12rpx; background:#FFFFFF; border-radius:20rpx; margin-top:14rpx; }
.mini-theme-aqua .mini-label { font-size:20rpx; font-weight:600; }
.mini-theme-aqua .mini-goal { padding:14rpx 0; margin-top:0; background:transparent; border-bottom:1rpx dashed var(--border); border-radius:0; font-size:18rpx; }
.mini-theme-aqua .mini-add { background:var(--soft); border-radius:14rpx; font-size:18rpx; }
.mini-theme-aqua .mini-note { background:var(--input); border-radius:14rpx; font-size:17rpx; }
.page.theme-aqua .theme-choice { border-width:2rpx; background:#FFFFFF; }
.page.theme-aqua .theme-choice.chosen { border-color:var(--accent); }
.theme-aqua .choice-copy { padding:20rpx; }
.theme-aqua .choice-name { font-size:28rpx; font-weight:600; }
.theme-aqua .intro { margin-bottom:26rpx; }
