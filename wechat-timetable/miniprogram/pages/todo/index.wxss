.page {
  min-height: 100vh;
  padding: 20rpx 20rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.overview {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  background: #dcecea;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 83, 77, 0.08);
}

.overview-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.overview-title {
  color: #213b36;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.overview-desc {
  color: #58706a;
  font-size: 23rpx;
  line-height: 1.45;
}

.add-button,
.empty-action,
.retry-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #ffffff;
  background: #267d78;
  font-weight: 700;
}

.add-button {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  font-size: 23rpx;
}

.filter-bar {
  display: flex;
  padding: 0 12rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(52, 83, 77, 0.05);
}

.filter-item {
  position: relative;
  flex: 1;
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #58706a;
  font-size: 25rpx;
  font-weight: 600;
}

.filter-item.active {
  color: #176c66;
}

.filter-item.active::after {
  content: '';
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 0;
  height: 5rpx;
  background: #267d78;
  border-radius: 5rpx 5rpx 0 0;
}

.filter-count {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #58706a;
  background: #eef4f2;
  border-radius: 19rpx;
  font-size: 20rpx;
  line-height: 1;
}

.active .filter-count {
  color: #176c66;
  background: #dcecea;
}

.todo-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.todo-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 22rpx 18rpx 22rpx 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 5rpx 16rpx rgba(52, 83, 77, 0.06);
}

.check-control {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  border: 3rpx solid #71837e;
  border-radius: 50%;
}

.check-control.checked {
  border-color: #267d78;
  background: #267d78;
}

.check-stem {
  position: absolute;
  left: 12rpx;
  top: 7rpx;
  width: 14rpx;
  height: 21rpx;
  box-sizing: border-box;
  border-right: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
}

.todo-content {
  flex: 1;
  min-width: 0;
}

.todo-title {
  display: block;
  color: #263d38;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.completed .todo-title {
  color: #58706a;
  text-decoration: line-through;
}

.todo-meta {
  display: flex;
  margin-top: 10rpx;
}

.due-label {
  padding: 6rpx 12rpx;
  color: #58706a;
  background: #eef4f2;
  border-radius: 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

.due-label.today {
  color: #8a5a16;
  background: #fdf0dc;
}

.due-label.overdue {
  color: #a3443f;
  background: #fae9e7;
}

.todo-note {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 10rpx;
  color: #58706a;
  font-size: 22rpx;
  line-height: 1.45;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.more-control {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  border-radius: 28rpx;
}

.more-dot {
  width: 6rpx;
  height: 6rpx;
  background: #82938e;
  border-radius: 50%;
}

.empty-state,
.problem-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 76rpx 44rpx;
  text-align: center;
  background: #ffffff;
  border-radius: 18rpx;
  box-shadow: 0 5rpx 16rpx rgba(52, 83, 77, 0.05);
}

.empty-mark {
  width: 132rpx;
  height: 112rpx;
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  background: #e8f3f1;
  border-radius: 18rpx;
  transform: rotate(-3deg);
}

.empty-line {
  width: 62rpx;
  height: 7rpx;
  background: #6da6a0;
  border-radius: 4rpx;
}

.empty-line.line-long {
  width: 84rpx;
}

.empty-line.line-short {
  width: 42rpx;
}

.empty-title,
.problem-title {
  margin-top: 28rpx;
  color: #263d38;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-desc,
.problem-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #58706a;
  font-size: 23rpx;
  line-height: 1.55;
}

.empty-action,
.retry-button {
  min-height: 64rpx;
  padding: 0 28rpx;
  margin-top: 28rpx;
  border-radius: 32rpx;
  font-size: 23rpx;
}

.problem-panel {
  align-items: flex-start;
  padding: 34rpx;
  text-align: left;
  background: #fff8f2;
}

.problem-title {
  margin-top: 0;
  color: #754b27;
}

.problem-desc {
  color: #8a6a4d;
}
