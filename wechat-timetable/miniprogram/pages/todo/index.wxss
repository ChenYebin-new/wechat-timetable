.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: var(--page);
  color: var(--text);
}

button {
  box-sizing: border-box;
}

button::after {
  border: none;
}

.plain-button {
  margin: 0;
  padding: 0;
  color: inherit;
  background: transparent;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
  border-radius: var(--radius-small);
}

/* Override native mini-button layout while preserving our icon touch targets. */
.plain-button.date-arrow,
.plain-button.check-control,
.plain-button.more-control {
  display: flex;
  margin: 0;
  padding: 0;
}

.plain-button.todo-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 20rpx 0;
}

.plain-button[disabled] {
  color: var(--muted);
  background: transparent;
  opacity: 0.55;
}

.control-pressed,
.content-pressed {
  background: var(--soft);
}

.date-navigation {
  display: flex;
  align-items: center;
  margin: 0 0 28rpx;
}

.date-arrow {
  width: 88rpx;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.chevron {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid var(--text);
  border-right: 2rpx solid var(--text);
  box-sizing: border-box;
}

.chevron.previous {
  transform: rotate(-135deg);
}

.chevron.next {
  transform: rotate(45deg);
}

/* Plain view slots allocate flex space; native controls fill them explicitly. */
.date-picker-slot {
  flex: 1;
  min-width: 0;
}

.date-picker {
  display: block;
  width: 100%;
}

.date-picker-content {
  width: 100%;
  min-height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.date-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.date-label {
  color: var(--accent);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.date-dropdown {
  width: 11rpx;
  height: 11rpx;
  border-right: 3rpx solid var(--text);
  border-bottom: 3rpx solid var(--text);
  transform: rotate(45deg);
  margin-top: -5rpx;
  flex-shrink: 0;
}

.weekday-label {
  display: block;
  width: 100%;
  flex-shrink: 0;
  white-space: nowrap;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.4;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  margin: -14rpx 0 20rpx;
}

.plain-button.today-button {
  display: flex;
  align-items: center;
  width: auto;
  min-height: 44px;
  margin: 0;
  padding: 0 12rpx;
  color: var(--accent);
  font-size: 25rpx;
}

.plain-button.calendar-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 44px;
  margin: 0 0 0 auto;
  padding: 0 12rpx;
  color: var(--accent);
  font-size: 25rpx;
  white-space: nowrap;
}

.calendar-icon {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid var(--accent);
  border-radius: 5rpx;
  box-sizing: border-box;
}

.calendar-icon-binding {
  position: absolute;
  top: -7rpx;
  width: 3rpx;
  height: 8rpx;
  background: var(--primary);
}

.calendar-icon-binding.left { left: 5rpx; }
.calendar-icon-binding.right { right: 5rpx; }

.calendar-icon-divider {
  position: absolute;
  top: 6rpx;
  width: 100%;
  border-top: 3rpx solid var(--accent);
}

.calendar-icon-dots {
  position: absolute;
  left: 5rpx;
  top: 13rpx;
  width: 4rpx;
  height: 4rpx;
  background: var(--primary);
  box-shadow: none;
}

.calendar-toggle-chevron {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid var(--accent);
  border-bottom: 3rpx solid var(--accent);
  transform: rotate(45deg);
  box-sizing: border-box;
}

.calendar-toggle-chevron.expanded { transform: rotate(-135deg); }

.calendar-panel {
  margin-bottom: 28rpx;
  padding: 12rpx 12rpx 16rpx;
  border-radius: var(--radius);
  background: var(--surface);
}

.calendar-heading {
  display: flex;
  align-items: center;
}

.plain-button.calendar-month-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  min-width: 44px;
  margin: 0;
  padding: 0;
  flex-shrink: 0;
}

.calendar-month-label {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
}

.calendar-weekdays,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-weekday {
  width: 14.285714%;
  padding: 8rpx 0;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
  text-align: center;
}

.plain-button.calendar-day {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  min-height: 44px;
  margin: 0;
  padding: 0;
  border-radius: 0;
}

.calendar-day-face {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 100%;
  max-width: 44px;
  height: 44px;
  border: 2rpx solid transparent;
  border-radius: var(--radius-small);
  box-sizing: border-box;
}

.calendar-day-number {
  font-size: 28rpx;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.outside-month .calendar-day-number { color: var(--muted); }
.calendar-today .calendar-day-face { border-color: var(--accent); }
.calendar-selected .calendar-day-face { border-color: var(--accent); background: var(--primary); }
.calendar-selected .calendar-day-number { color: var(--on-primary); }

.calendar-goal-dot {
  width: 6rpx;
  height: 6rpx;
  min-width: 3px;
  min-height: 3px;
  border-radius: 50%;
  background: transparent;
}

.calendar-goal-dot.has-goals { background: var(--primary); }
.calendar-selected .calendar-goal-dot.has-goals { background: var(--surface); }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.section-title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.completion-count {
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.todo-list,
.empty-state,
.goal-editor,
.reflection-panel {
  background: var(--surface);
  border-radius: var(--radius);
}

.todo-list {
  padding: 4rpx 16rpx;
}

.todo-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-top: 1rpx solid var(--border);
}

.todo-row:first-child {
  border-top: none;
}

.check-control {
  width: 88rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.check-circle {
  position: relative;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid var(--muted);
  border-radius: 50%;
  box-sizing: border-box;
}

.check-circle.checked {
  border-color: var(--accent);
  background: var(--primary);
}

.check-stem,
.status-stem {
  position: absolute;
  left: 11rpx;
  top: 6rpx;
  width: 13rpx;
  height: 20rpx;
  border-right: 3rpx solid var(--on-primary);
  border-bottom: 3rpx solid var(--on-primary);
  box-sizing: border-box;
  transform: rotate(45deg);
}

.todo-content-slot {
  flex: 1;
  min-width: 0;
}

.todo-content {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 0;
  text-align: left;
}

.todo-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.45;
  word-break: break-all;
}

.completed .todo-title {
  color: var(--muted);
  text-decoration: line-through;
}

.expired-label {
  display: block;
  margin-top: 6rpx;
  color: var(--warning);
  font-size: 22rpx;
  line-height: 1.45;
}

.todo-note {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.more-control {
  width: 72rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.more-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--muted);
}

.empty-state {
  min-height: 176rpx;
  padding: 44rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  text-align: center;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.empty-desc {
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.goal-editor {
  margin-top: 20rpx;
}

.add-goal,
.editor-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: var(--accent);
  font-size: 30rpx;
  font-weight: 600;
}

.add-goal {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius);
  text-align: left;
}

.add-mark {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--primary);
  flex-shrink: 0;
}

.plus-line {
  position: absolute;
  background: var(--surface);
  border-radius: 2rpx;
}

.plus-line.horizontal {
  left: 9rpx;
  top: 17rpx;
  width: 18rpx;
  height: 3rpx;
}

.plus-line.vertical {
  left: 17rpx;
  top: 9rpx;
  width: 3rpx;
  height: 18rpx;
}

.editor-content {
  padding: 24rpx;
}

.editor-heading {
  margin-bottom: 24rpx;
}

.title-input,
.goal-note-input {
  width: 100%;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-small);
  background: var(--input);
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.title-input {
  height: 80rpx;
}

.placeholder {
  color: var(--muted);
  font-size: 27rpx;
}

.note-toggle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
  text-align: left;
  font-size: 25rpx;
}

.note-chevron {
  width: 15rpx;
  height: 15rpx;
  border-right: 3rpx solid var(--text);
  border-bottom: 3rpx solid var(--text);
  box-sizing: border-box;
  transform: rotate(45deg);
}

.note-chevron.expanded {
  transform: rotate(-135deg);
}

.goal-note-input {
  min-height: 120rpx;
}

.editor-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 24rpx;
}

.cancel-button {
  min-width: 112rpx;
  min-height: 76rpx;
  padding: 18rpx 16rpx;
  color: var(--muted);
  font-size: 27rpx;
}

.save-button {
  min-width: 168rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 18rpx 24rpx;
  color: var(--on-primary);
  background: var(--primary);
  border-radius: var(--radius-small);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.save-button-pressed {
  background: var(--primary);
}

.save-button[disabled] {
  color: var(--on-primary);
  background: var(--disabled);
}

.reflection-heading {
  margin-top: 36rpx;
}

.note-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.note-status.saved,
.note-status.saving {
  color: var(--accent);
}

.note-status.error {
  color: var(--danger);
}

.status-check {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--primary);
}

.status-stem {
  left: 8rpx;
  top: 5rpx;
  width: 9rpx;
  height: 14rpx;
  border-width: 2rpx;
}

.reflection-panel {
  padding: 24rpx;
}

.daily-note-input {
  width: 100%;
  min-height: 168rpx;
  color: var(--text);
  font-size: 27rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.reflection-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.inline-problem {
  display: block;
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.problem-panel {
  padding: 24rpx;
  border-radius: var(--radius);
  background: var(--warning-soft);
}

.problem-title {
  display: block;
  color: var(--warning);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}

.problem-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--warning);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.retry-button {
  min-height: 72rpx;
  padding: 18rpx 20rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.problem-panel .retry-button {
  margin-top: 12rpx;
}

.note-save-problem,
.goal-read-problem {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.note-save-problem .inline-problem,
.goal-read-problem .inline-problem {
  flex: 1;
  min-width: 280rpx;
  margin-top: 0;
}

.expiry-hint {
  display: block;
  margin-top: 36rpx;
  padding: 0 12rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

/* Preserve a 44px touch target even when rpx scales down on narrow phones. */
.date-arrow,
.date-picker-content,
.check-control,
.more-control,
.today-button,
.add-goal,
.note-toggle,
.cancel-button,
.save-button,
.retry-button {
  min-height: 44px;
}

.date-arrow,
.check-control,
.more-control {
  min-width: 44px;
}

/* C/E composition: date tools, goal cards, then a complete journal panel. */
.page { min-height:0; padding:14rpx 22rpx calc(150rpx + env(safe-area-inset-bottom)); }
.date-controls { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; margin:0 0 22rpx; }
.date-navigation { flex:1 1 340rpx; min-width:0; margin:0; }
.date-picker-content { min-height:108rpx; }
.date-label { font-size:38rpx; font-weight:700; color:var(--text); }
.date-arrow { background:var(--soft); border-radius:50%; }
.plain-button.date-arrow { width:44px !important; min-width:44px; min-height:44px; height:44px; }
.calendar-toolbar { display:flex; flex-shrink:0; align-items:center; gap:8rpx; margin:0 0 0 auto; }
.plain-button.calendar-toggle,.plain-button.today-button { background:var(--surface); border:1rpx solid var(--border); border-radius:18rpx; min-height:44px; margin:0; padding:0 14rpx; color:var(--text); font-size:24rpx; }
.calendar-toggle-chevron { display:none; }
.calendar-icon { border-color:var(--text); }
.calendar-icon-divider { border-color:var(--text); }
.calendar-icon-binding,.calendar-icon-dots { background:var(--text); }
.calendar-open .date-label,.theme-campus .date-label { font-size:27rpx; }
.calendar-open .weekday-label,.theme-campus .weekday-label { display:none; }
.calendar-open .date-picker-content,.theme-campus .date-picker-content { min-height:44px; }
.calendar-open .date-navigation,.theme-campus .date-navigation { background:var(--surface); border-radius:28rpx; }
.calendar-open .date-arrow,.theme-campus .date-arrow { background:transparent; }
.calendar-open .date-controls { gap:8rpx; }
.calendar-open .date-heading { gap:8rpx; }
.calendar-open .plain-button.calendar-toggle,.calendar-open .plain-button.today-button { padding:0 10rpx; font-size:23rpx; }
.calendar-panel { padding:6rpx 12rpx 14rpx; margin-bottom:20rpx; border:1rpx solid var(--border); border-radius:20rpx; }
.calendar-month-label { font-size:30rpx; }
.calendar-weekdays { background:var(--grid-head); border-top:1rpx solid var(--border); border-bottom:1rpx solid var(--border); }
.calendar-weekday { color:var(--text); }
.plain-button.calendar-day { border-right:1rpx solid var(--border); border-bottom:1rpx solid var(--border); }
.calendar-day-face { border-radius:12rpx; }
.calendar-selected .calendar-day-face { background:var(--primary); border-color:transparent; }
.theme-campus .calendar-selected .calendar-day-face { background:var(--selected); }
.theme-campus .calendar-selected .calendar-day-number { color:var(--text); }
.theme-campus .calendar-selected .calendar-goal-dot.has-goals { background:#E2B846; }
.theme-campus .calendar-panel { border-color:transparent; }
.goals-section,.journal-section { background:var(--surface); border:1rpx solid var(--border); border-radius:20rpx; padding:18rpx; margin-bottom:22rpx; }
.theme-campus .goals-section,.theme-campus .journal-section { border-color:transparent; border-radius:26rpx; }
.section-heading { gap:14rpx; margin:2rpx 2rpx 18rpx; }
.section-title { flex:1; font-size:34rpx; }
.section-icon { width:50rpx; height:50rpx; flex-shrink:0; }
.completion-count { font-size:24rpx; }
.todo-list { padding:0; border:0; background:transparent; }
.todo-row { border:1rpx solid var(--border); border-radius:18rpx; margin-bottom:10rpx; min-height:106rpx; }
.todo-row:first-child { border-top:1rpx solid var(--border); }
.plain-button.todo-content { padding:14rpx 0; }
.todo-title { font-size:28rpx; font-weight:600; line-height:1.4; }
.completed .todo-title { font-weight:400; }
.todo-note { margin-top:4rpx; font-size:24rpx; }
.plain-button.check-control,.plain-button.more-control { width:44px !important; min-width:44px; min-height:44px; }
.check-circle.checked { background:var(--primary); border-color:var(--primary); }
.goal-editor { margin-top:14rpx; background:var(--soft); border-radius:18rpx; }
.add-goal { justify-content:center; min-height:44px; padding:16rpx; font-weight:500; }
.add-mark { width:30rpx; height:30rpx; background:transparent; border-radius:0; }
.plus-line { background:var(--accent); }
.plus-line.horizontal { width:30rpx; left:0; top:14rpx; }
.plus-line.vertical { height:30rpx; top:0; left:14rpx; }
.reflection-heading { margin-top:2rpx; }
.reflection-panel { padding:22rpx; border:1rpx solid var(--border); border-radius:18rpx; background:var(--surface); }
.theme-campus .reflection-panel { background:var(--input); }
.daily-note-input { min-height:250rpx; font-size:28rpx; line-height:1.65; }
.status-check { background:var(--success); }
.status-stem { border-color:var(--on-dark); }
.note-status.saved { color:var(--muted); }
.reflection-footer { font-size:24rpx; margin:18rpx 0 0; }
.expiry-hint { margin:12rpx 0 0; padding:0; font-size:21rpx; text-align:left; }
.save-button,.cancel-button,.note-toggle,.retry-button { min-height:44px; }
.save-button[disabled] { color:var(--muted); background:var(--disabled); }
.title-input { height:48px; }
.calendar-open .daily-note-input { min-height:200rpx; }
