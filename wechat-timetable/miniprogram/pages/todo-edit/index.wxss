.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 26rpx;
  margin-bottom: 22rpx;
  background: #dcecea;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(52, 83, 77, 0.08);
}

.intro-title {
  color: #213b36;
  font-size: 31rpx;
  font-weight: 700;
}

.intro-desc {
  color: #526963;
  font-size: 23rpx;
  line-height: 1.5;
}

.form {
  padding: 0 26rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 83, 77, 0.06);
}

.field {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid #edf2f0;
}

.field:last-child {
  border-bottom: none;
}

.field-column {
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  padding: 26rpx 0;
}

.field-heading,
.date-field,
.date-actions {
  display: flex;
  align-items: center;
}

.field-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.label {
  color: #304742;
  font-size: 27rpx;
  font-weight: 600;
}

.counter,
.field-hint {
  color: #58706a;
  font-size: 21rpx;
}

.title-input {
  width: 100%;
  height: 68rpx;
  color: #223b36;
  font-size: 29rpx;
}

.placeholder {
  color: #58706a;
}

.date-field {
  justify-content: space-between;
}

.field-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.date-actions {
  flex-shrink: 0;
  gap: 12rpx;
}

.schedule-field {
  gap: 18rpx;
}

.schedule-add {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #176c66;
  background: #e8f3f1;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.schedule-pickers,
.schedule-time-range {
  display: flex;
  align-items: center;
}

.schedule-pickers {
  gap: 12rpx;
}

.schedule-date-picker {
  flex: 1.15;
  min-width: 0;
}

.schedule-time-range {
  flex: 1;
  min-width: 0;
  gap: 8rpx;
}

.schedule-time-picker {
  flex: 1;
  min-width: 0;
}

.schedule-picker-value {
  min-height: 62rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #176c66;
  background: #e8f3f1;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.schedule-picker-value.muted {
  color: #58706a;
  background: #f3f6f5;
}

.time-separator {
  flex-shrink: 0;
  color: #58706a;
  font-size: 21rpx;
}

.picker-value,
.clear-date {
  min-height: 56rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-radius: 28rpx;
  font-size: 23rpx;
}

.picker-value {
  color: #176c66;
  background: #e8f3f1;
  font-weight: 600;
}

.picker-value.muted {
  color: #58706a;
  background: #f3f6f5;
}

.clear-date,
.clear-schedule {
  color: #8c5c34;
  background: #fff4e8;
}

.clear-schedule {
  min-height: 56rpx;
  padding: 0 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  border-radius: 28rpx;
  font-size: 23rpx;
}

.note-field {
  min-height: 230rpx;
}

.note-input {
  width: 100%;
  min-height: 130rpx;
  color: #304742;
  font-size: 27rpx;
  line-height: 1.55;
}

.save-button {
  height: 88rpx;
  margin: 44rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #267d78;
  border-radius: 44rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 10rpx 24rpx rgba(38, 125, 120, 0.18);
}

.save-button[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: #7eaaa6;
}
