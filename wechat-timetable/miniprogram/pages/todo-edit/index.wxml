<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<view class="page">
  <view class="intro">
    <text class="intro-title">{{isEdit ? '完善这件事' : '记下一件要做的事'}}</text>
    <text class="intro-desc">标题保持简短；日期和备注都可以稍后再补。</text>
  </view>

  <view class="form">
    <view class="field field-column">
      <view class="field-heading">
        <text class="label">待办标题</text>
        <text class="counter">{{title.length}} / 60</text>
      </view>
      <input
        class="title-input"
        value="{{title}}"
        maxlength="60"
        placeholder="例如：整理本周复习计划"
        placeholder-class="placeholder"
        bindinput="onTitle"
        aria-label="待办标题"
      />
    </view>

    <view class="field date-field">
      <view class="field-copy">
        <text class="label">截止日期</text>
        <text class="field-hint">可选，不会自动发送提醒</text>
      </view>
      <view class="date-actions">
        <view wx:if="{{dueDate}}" class="clear-date" bindtap="onClearDate" aria-role="button" aria-label="清除截止日期">清除</view>
        <picker mode="date" value="{{datePickerValue}}" bindchange="onDate" aria-label="选择截止日期">
          <view class="picker-value {{dueDate ? '' : 'muted'}}">{{dueDate || '选择日期'}}</view>
        </picker>
      </view>
    </view>

    <view class="field field-column note-field">
      <view class="field-heading">
        <text class="label">备注</text>
        <text class="counter">{{note.length}} / 200</text>
      </view>
      <textarea
        class="note-input"
        value="{{note}}"
        maxlength="200"
        auto-height="true"
        placeholder="补充资料、地点或下一步（可选）"
        placeholder-class="placeholder"
        bindinput="onNote"
        aria-label="待办备注"
      ></textarea>
    </view>
  </view>

  <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">{{isEdit ? '保存修改' : '创建待办'}}</button>
</view>
</block>
