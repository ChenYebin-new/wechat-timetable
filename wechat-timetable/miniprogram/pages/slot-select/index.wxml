<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="选择上课时段" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="intro">
    <text class="intro-desc">点选空白格，同一天连续节次自动合并。已有课程的时段不可选。</text>
  </view>

  <view wx:if="{{ready}}" class="grid-frame">
    <timetable-grid class="course-grid" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}"
      periods="{{periods}}"
      day-slots="{{daySlots}}"
      selection-mode="{{true}}"
      selected-keys="{{selectedKeys}}"
      disabled-keys="{{disabledKeys}}"
      hold-enabled="{{false}}"
      bind:celltap="onCellTap"
      bind:occupiedtap="onOccupiedTap"
    />
  </view>

  <view class="selection-bar">
    <view class="selection-copy">
      <text class="selection-title">已选 {{selectedCount}} 格 · {{rangeCount}} 个时段</text>
      <text class="selection-detail">{{summary || '请点击课表中的空白格'}}</text>
    </view>
    <view class="selection-actions">
      <view class="selection-cancel" bindtap="onCancel" aria-role="button" aria-label="取消重新选择">取消</view>
      <view class="selection-done {{selectedCount ? '' : 'disabled'}}" bindtap="onDone" aria-role="button" aria-label="完成时段选择" aria-disabled="{{!selectedCount}}">完成</view>
    </view>
  </view>
</view>
</block>
