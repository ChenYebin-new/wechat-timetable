.page {
  min-height: 100vh;
  padding: 20rpx 20rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 14rpx;
  padding: 18rpx 20rpx;
  color: var(--text);
  background: var(--soft);
  border-radius: var(--radius);
  box-shadow: none;
}

.intro-desc {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.grid-frame {
  overflow: hidden;
  border-radius: var(--radius);
}

.selection-bar {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 16rpx 18rpx 16rpx 22rpx;
  box-sizing: border-box;
  color: var(--on-primary);
  background: var(--selection-bar);
  border-radius: var(--radius);
  box-shadow: none;
}

.selection-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.selection-title {
  font-size: 25rpx;
  font-weight: 700;
}

.selection-detail {
  overflow: hidden;
  color: var(--selection-muted);
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selection-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.selection-cancel,
.selection-done {
  height: 64rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 32rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.selection-cancel {
  color: var(--selection-muted);
  background: rgba(255, 255, 255, 0.12);
}

.selection-done {
  color: var(--accent);
  background: var(--on-dark);
}

.selection-done.disabled {
  opacity: 0.42;
}

.selection-cancel,.selection-done { min-height: 44px; }
.selection-bar { color: var(--on-dark); }
.selection-done { background: var(--surface); color: var(--accent); }

.page { min-height: 0; padding-top: 22rpx; }
.theme-paper .intro { border-radius:8rpx; }
.theme-swiss .intro,.theme-pixel .intro { border-radius:0; }
