.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  background: var(--soft);
  border-radius: var(--radius);
}

.intro-title {
  color: var(--text);
  font-size: 30rpx;
  font-weight: 700;
}

.intro-desc {
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.custom-state {
  margin-top: 4rpx;
  color: var(--accent);
  font-size: 21rpx;
  font-weight: 600;
}

.time-card {
  padding: 0 26rpx;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: none;
}

.time-row {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.duration-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.duration-value {
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.row-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--accent);
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.chevron {
  color: var(--muted);
  font-size: 42rpx;
  font-weight: 300;
}

.divider {
  height: 2rpx;
  background: var(--border);
}

.impact {
  margin: 18rpx 6rpx 28rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.save-btn {
  margin-top: 32rpx;
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}

.save-btn-pressed {
  background: var(--primary);
  transform: scale(0.98);
}

.time-card { border: 1rpx solid var(--border); }
.save-btn { min-height: 48px; }

.page { min-height: 0; padding-top: 22rpx; }
