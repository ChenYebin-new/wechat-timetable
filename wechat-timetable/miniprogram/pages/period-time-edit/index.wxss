.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  background: var(--soft);
  border-radius: var(--radius);
}

.intro-desc {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.custom-state {
  margin-top: 4rpx;
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.time-card {
  padding: 0 26rpx;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: none;
}

.time-row {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.duration-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.duration-value {
  color: var(--muted);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.row-title {
  color: var(--text);
  font-size: 28rpx;
  font-weight: 500;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--accent);
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.chevron {
  color: var(--muted);
  font-size: 42rpx;
  font-weight: 300;
}

.divider {
  height: 2rpx;
  background: var(--border);
}

.impact {
  margin: 18rpx 6rpx 28rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.save-btn {
  margin-top: 32rpx;
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}

.save-btn-pressed {
  background: var(--primary);
  transform: scale(0.98);
}

.time-card { border: 1rpx solid var(--border); }
.save-btn { min-height: 48px; }

.page { min-height: 0; padding-top: 22rpx; }
.save-hint { display:block; margin:16rpx 4rpx 0; color:var(--muted); font-size:24rpx; line-height:1.6; text-align:center; }
.theme-paper .intro { border-radius:8rpx; }
.theme-swiss .intro,.theme-pixel .intro { border-radius:0; }

.theme-aqua .intro { padding:26rpx; background:rgba(255,255,255,.65); border:1rpx solid rgba(255,255,255,.9); border-radius:28rpx; }
.theme-aqua .time-card { padding:0 28rpx; }
.theme-aqua .time-row { min-height:126rpx; }
.theme-aqua .row-title { font-size:29rpx; }
.theme-aqua .row-value { font-size:32rpx; font-weight:500; }
.theme-aqua .divider { height:1rpx; }
.theme-aqua .chevron { width:12rpx; height:12rpx; margin:0 5rpx 0 10rpx; border-right:2rpx solid var(--muted); border-top:2rpx solid var(--muted); transform:rotate(45deg); font-size:0; flex-shrink:0; }
.theme-aqua .time-row,.theme-aqua .save-btn { transition:opacity 120ms ease-out; }
.theme-aqua .time-row.aqua-picker-pressed { opacity:.84; }
.theme-aqua .save-btn.save-btn-pressed { transform:none; opacity:.84; }
@media (prefers-reduced-motion:reduce) {
  .theme-aqua .time-row,.theme-aqua .save-btn { transition:none; }
}
