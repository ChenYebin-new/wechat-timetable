<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<!-- pages/term-settings/index.wxml -->
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="学期设置" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="card">
    <text class="card-title">第一教学周的星期一</text>
    <text class="card-desc">教学周从这一天开始计算，日期仅可选择星期一。</text>
    <monday-picker theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" id="term-monday-picker" value="{{startDate}}" bindchange="onDateChange">
      <view class="picker-value">{{startDate}}（周一）</view>
    </monday-picker>
  </view>

  <view class="card">
    <text class="card-title">学期总周数</text>
    <view class="chips">
      <view
        wx:for="{{commonWeeks}}"
        wx:key="*this"
        class="chip {{totalWeeks === item ? 'active' : ''}}"
        data-week="{{item}}"
        bindtap="onCommonWeek"
        aria-role="radio"
        aria-label="学期共{{item}}周{{totalWeeks === item ? '，已选择' : ''}}"
        aria-checked="{{totalWeeks === item}}"
      >{{item}} 周</view>
    </view>
    <picker mode="selector" range="{{weekOptions}}" value="{{totalWeeks - 1}}" bindchange="onWeeksChange" aria-label="选择学期总周数">
      <view class="picker-value">{{totalWeeks}} 周（1–30 可调）</view>
    </picker>
  </view>

  <view wx:if="{{isMigration}}" class="notice">
    <text class="notice-title">需要升级旧课表数据</text>
    <text class="notice-desc">检测到 {{affectedCount}} 门旧课程。设置学期后，它们将按"全部周"迁移到新学期（迁移前会自动备份当前课表）。</text>
  </view>

  <button class="save-btn hover-btn" hover-class="save-btn-pressed" bindtap="onSave">{{isMigration ? '设置并迁移' : '保存学期设置'}}</button>
</view>
</block>
