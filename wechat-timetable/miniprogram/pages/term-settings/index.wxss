/* pages/term-settings/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 26rpx 26rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: none;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.card-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: var(--input);
  border-radius: var(--radius-small);
  font-size: 28rpx;
  color: var(--text);
}

.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chip {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  background: var(--soft);
  color: var(--accent);
  font-size: 24rpx;
  font-weight: 600;
}

.chip.active {
  background: var(--primary);
  color: var(--on-primary);
}

.notice {
  padding: 20rpx 24rpx;
  background: var(--warning-soft);
  border-radius: var(--radius-small);
  margin-bottom: 22rpx;
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--warning);
}

.notice-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--warning);
  line-height: 1.5;
}

.save-btn {
  border-radius: var(--radius);
  background: var(--primary);
  color: var(--on-primary);
  font-size: 30rpx;
}

.save-btn-pressed {
  background: var(--primary);
  transform: scale(0.98);
}

.save-btn::after {
  border: 0;
}

.card { border: 1rpx solid var(--border); }
.chip,.picker-value,.save-btn { min-height: 44px; }

.page { min-height: 0; padding-top: 22rpx; }
.picker-value::after { content:''; width:12rpx; height:12rpx; margin:-6rpx 4rpx 0 16rpx; flex-shrink:0; border-right:2rpx solid var(--muted); border-bottom:2rpx solid var(--muted); transform:rotate(45deg); }
