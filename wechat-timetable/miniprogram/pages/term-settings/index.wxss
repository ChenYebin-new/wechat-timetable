/* pages/term-settings/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 26rpx 26rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(52, 83, 77, 0.06);
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #223;
}

.card-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #71837e;
  line-height: 1.5;
}

.picker-value {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: #f5f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #223;
}

.chips {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 12rpx 26rpx;
  border-radius: 28rpx;
  background: #e8f3f1;
  color: #267d78;
  font-size: 24rpx;
  font-weight: 600;
}

.chip.active {
  background: #267d78;
  color: #ffffff;
}

.notice {
  padding: 20rpx 24rpx;
  background: #fdf3e7;
  border-radius: 16rpx;
  margin-bottom: 22rpx;
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #9a5b13;
}

.notice-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8a6a3f;
  line-height: 1.5;
}

.save-btn {
  border-radius: 44rpx;
  background: #267d78;
  color: #ffffff;
  font-size: 30rpx;
}

.save-btn::after {
  border: 0;
}
