<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<!-- pages/course-edit/index.wxml -->
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="{{isEdit ? '编辑课程' : '新增课程'}}" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="form">
    <view class="field">
      <text class="label">课程名称</text>
      <view class="input-shell"><input class="input" value="{{name}}" placeholder="必填" placeholder-class="ph" bindinput="onName" aria-label="课程名称" /><button wx:if="{{themeId === 'campus' && name}}" class="pressable clear-input" data-field="name" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onClearField" aria-label="清除课程名称"><view class="clear-mark" /></button></view>
    </view>

    <block wx:if="{{isGroupMode}}">
      <view class="field field-column range-field">
        <view class="range-heading">
          <text class="label">上课时段</text>
          <view class="pressable range-edit" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onReselect" aria-role="button" aria-label="重新选择上课时段">重新选择<view class="link-chevron" /></view>
        </view>
        <view wx:if="{{rangeItems.length}}" class="range-list">
          <text class="range-chip" wx:for="{{rangeItems}}" wx:key="*this">{{item}}</text>
        </view>
        <text wx:else class="field-hint range-empty">还没有选择上课时段</text>
      </view>
    </block>
    <block wx:else>
      <view class="field">
        <text class="label">星期</text>
        <picker mode="selector" range="{{dayOptions}}" value="{{dayIndex}}" bindchange="onDay" aria-label="选择星期">
          <view class="picker-value">{{dayOptions[dayIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">开始节次</text>
        <picker mode="selector" range="{{periodOptions}}" value="{{startIndex}}" bindchange="onStart" aria-label="选择开始节次">
          <view class="picker-value">{{periodOptions[startIndex]}}</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">结束节次</text>
        <picker mode="selector" range="{{periodOptions}}" value="{{endIndex}}" bindchange="onEnd" aria-label="选择结束节次">
          <view class="picker-value">{{periodOptions[endIndex]}}</view>
        </picker>
      </view>
    </block>

    <view class="field">
      <text class="label">教师</text>
      <view class="input-shell"><input class="input" value="{{teacher}}" placeholder="可选" placeholder-class="ph" bindinput="onTeacher" aria-label="教师" /><button wx:if="{{themeId === 'campus' && teacher}}" class="pressable clear-input" data-field="teacher" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onClearField" aria-label="清除教师"><view class="clear-mark" /></button></view>
    </view>

    <view class="field">
      <text class="label">教室</text>
      <view class="input-shell"><input class="input" value="{{location}}" placeholder="可选" placeholder-class="ph" bindinput="onLocation" aria-label="教室" /><button wx:if="{{themeId === 'campus' && location}}" class="pressable clear-input" data-field="location" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onClearField" aria-label="清除教室"><view class="clear-mark" /></button></view>
    </view>

    <view class="field">
      <text class="label">周次</text>
      <block wx:if="{{totalWeeks > 0}}">
        <view class="week-control">
        <picker mode="selector" range="{{weekModeLabels}}" value="{{weekModeIndex}}" bindchange="onWeekMode" aria-label="选择课程周次模式">
          <view class="picker-value">{{weekModeLabels[weekModeIndex]}}</view>
        </picker>
        <text wx:if="{{weekMode === 'all'}}" class="field-hint week-range">第1—{{totalWeeks}}周</text>
        </view>
      </block>
      <text wx:else class="field-hint">设置学期后可配置周次</text>
    </view>

    <view wx:if="{{totalWeeks > 0 && weekMode === 'custom'}}" class="field field-column">
      <text class="label">选择周次</text>
      <view class="week-chips">
        <view
          wx:for="{{weekChips}}"
          wx:key="value"
          class="pressable week-chip {{item.selected ? 'active' : ''}}"
          data-week="{{item.value}}"
          hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onToggleWeek"
          aria-role="checkbox"
          aria-label="第{{item.value}}周{{item.selected ? '，已选择' : ''}}"
          aria-checked="{{item.selected}}"
        >{{item.selected ? '✓' : ''}}{{item.value}}</view>
      </view>
    </view>

  </view>
    <view class="actions">
      <button class="pressable btn btn-primary" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
      <button wx:if="{{isEdit}}" class="pressable btn btn-danger" hover-class="press-feedback" hover-start-time="20" hover-stay-time="80" bindtap="onDelete"><view wx:if="{{themeId === 'paper'}}" class="delete-rule" aria-hidden="true" /><text>删除课程</text><view wx:if="{{themeId === 'paper'}}" class="delete-rule" aria-hidden="true" /></button>
    </view>
</view>
</block>
