<page-meta page-style="{{appearanceStyle}}background:var(--page);background-image:var(--page-texture);font-family:var(--font-family);color:var(--text);" />
<!-- pages/data-manage/index.wxml -->
<share-home-preview wx:if="{{showShareHomePreview}}" />
<block wx:else>
<page-header class="page-masthead" title="课表数据管理" subtitle="" home="{{false}}" theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" art="{{appearanceArt}}" />
<view class="page theme-{{themeId}}" style="{{appearanceStyle}}">
  <view class="card">
    <text class="card-title">导出课表</text>
    <text class="card-desc">复制备份文本，可保存到备忘录或转移到其他设备。</text>
    <button class="btn btn-primary" bindtap="onExport">复制课表备份</button>
  </view>

  <view class="card">
    <text class="card-title">导入课表</text>
    <textarea
      class="input"
      value="{{inputText}}"
      placeholder="粘贴完整的课表备份文本"
      aria-label="课表备份文本"
      bindinput="onInput"
      maxlength="-1"
    />
    <button class="btn btn-secondary" bindtap="onParse">解析并预览</button>

    <view wx:if="{{previewErrors.length}}" class="error-box">
      <text class="error-line" wx:for="{{previewErrors}}" wx:key="index">{{item}}</text>
    </view>

    <view wx:if="{{preview}}" class="preview">
      <view class="row"><text class="k">导出时间</text><text class="v">{{preview.exportedAt}}</text></view>
      <view class="row"><text class="k">课表数据版本</text><text class="v">V{{preview.schemaVersion}}</text></view>
      <view class="row"><text class="k">备份课程</text><text class="v">{{preview.backupGroupCount}} 门 / {{preview.backupCount}} 个时段</text></view>
      <view class="row"><text class="k">当前课程</text><text class="v">{{preview.currentGroupCount}} 门 / {{preview.currentCount}} 个时段</text></view>
      <view class="row"><text class="k">将新增</text><text class="v">{{preview.mergeAddGroupCount}} 门 / {{preview.mergeAddCount}} 个时段</text></view>
      <view class="row"><text class="k">重复课程（跳过）</text><text class="v">{{preview.mergeSkipDuplicateGroupCount}} 门</text></view>
      <view class="row"><text class="k">冲突课程（跳过）</text><text class="v">{{preview.mergeSkipConflictGroupCount}} 门</text></view>
      <view class="row"><text class="k">合并后课程</text><text class="v">{{preview.mergeFinalGroupCount}} 门 / {{preview.mergeFinalCount}} 个时段</text></view>
      <view wx:if="{{preview.skippedGroupReasons.length}}" class="merge-warning">
        <text wx:for="{{preview.skippedGroupReasons}}" wx:key="index">{{item}}</text>
      </view>
      <view wx:if="{{!preview.mergeAllowed}}" class="merge-warning">{{preview.mergeReason}}</view>

      <view wx:if="{{needsTerm}}" class="term-setup">
        <text class="term-setup-title">这是旧版（V1）备份，导入前请确认学期设置。日期列表仅显示星期一。</text>
        <view class="term-row">
          <text class="k">第一教学周星期一</text>
          <monday-picker theme-id="{{themeId}}" appearance-style="{{appearanceStyle}}" id="term-monday-picker" value="{{termStartDate}}" bindchange="onTermDate">
            <view class="v picker-date">{{termStartDate}}（周一）</view>
          </monday-picker>
        </view>
        <view class="term-row">
          <text class="k">学期总周数</text>
          <picker mode="selector" range="{{weekOptions}}" value="{{termTotalWeeks - 1}}" bindchange="onTermWeeks">
            <view class="v picker-date">{{termTotalWeeks}} 周</view>
          </picker>
        </view>
      </view>

      <view class="actions">
        <button class="btn btn-primary" bindtap="onOverwrite">覆盖现有课表</button>
        <button class="btn btn-secondary" bindtap="onMerge" disabled="{{!preview.mergeAllowed}}">合并到现有课表</button>
      </view>
    </view>
  </view>

  <view class="card">
    <text class="card-title">最近自动备份</text>
    <block wx:if="{{recentBackupInfo}}">
      <view class="row"><text class="k">备份时间</text><text class="v">{{recentBackupInfo.savedAtText}}</text></view>
      <view class="row"><text class="k">数据版本</text><text class="v">V{{recentBackupInfo.schemaVersion}}</text></view>
      <view class="row"><text class="k">课程数量</text><text class="v">{{recentBackupInfo.groupCount}} 门 / {{recentBackupInfo.segmentCount}} 个时段</text></view>
      <button class="btn btn-danger" bindtap="onRestoreRecent">恢复最近备份</button>
    </block>
    <text wx:else class="card-desc">暂无自动备份。自动备份只保留最近一份。</text>
  </view>
</view>
</block>
