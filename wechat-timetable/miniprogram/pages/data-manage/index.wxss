/* pages/data-manage/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  padding: 26rpx 26rpx 28rpx;
  margin-bottom: 22rpx;
  box-shadow: none;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.card-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.input {
  width: 100%;
  height: 240rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: var(--text);
  background: var(--input);
  border-radius: var(--radius-small);
}

.btn {
  margin-top: 22rpx;
  border-radius: var(--radius);
  font-size: 28rpx;
}

.btn::after {
  border: 0;
}

.btn-primary {
  color: var(--on-primary);
  background: var(--primary);
}

.btn-secondary {
  color: var(--accent);
  background: var(--soft);
}

.btn-danger {
  color: var(--danger);
  background: var(--danger-soft);
}

.error-box {
  margin-top: 20rpx;
  padding: 16rpx;
  background: var(--danger-soft);
  border-radius: var(--radius-small);
}

.error-line {
  display: block;
  font-size: 24rpx;
  color: var(--danger);
  line-height: 1.5;
}

.merge-warning {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--radius-small);
  background: var(--warning-soft);
  color: var(--warning);
  font-size: 23rpx;
  line-height: 1.5;
}

.preview {
  margin-top: 22rpx;
  padding-top: 8rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.row:last-child {
  border-bottom: none;
}

.k {
  width: 220rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.v {
  flex: 1;
  font-size: 25rpx;
  color: var(--text);
  text-align: right;
  word-break: break-all;
}

.term-setup {
  margin-top: 16rpx;
  padding: 16rpx;
  background: var(--warning-soft);
  border-radius: var(--radius-small);
}

.term-setup-title {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--warning);
  margin-bottom: 8rpx;
}

.term-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.picker-date {
  text-align: right;
  color: var(--text);
  font-size: 25rpx;
}

.actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.actions .btn {
  flex: 1;
  margin-top: 0;
}

.btn[disabled] {
  opacity: 0.5;
}

.card { border: 1rpx solid var(--border); }
.btn { min-height: 48px; line-height: 1.5; padding: 20rpx 16rpx; }
.btn[disabled] { opacity: 1; background: var(--disabled); color: var(--muted); }
.input { border: 1rpx solid var(--border); }
.input::placeholder { color: var(--muted); }

.page { min-height: 0; padding-top: 22rpx; }

/* Backup actions follow the full-width reference composition. */
.page { min-height:0; padding:22rpx 24rpx calc(36rpx + env(safe-area-inset-bottom)); }
.card { padding:24rpx; border-radius:24rpx; }
.theme-campus .card { border-color:transparent; }
.card-title { font-size:32rpx; }
.backup-heading { display:flex; align-items:center; gap:24rpx; }
.backup-icon { width:78rpx; height:78rpx; padding:16rpx; box-sizing:border-box; flex-shrink:0; border-radius:18rpx; }
.icon-export { background:var(--icon-export-bg); }
.icon-import { background:var(--icon-import-bg); }
.icon-recent { background:var(--icon-recent-bg); }
.backup-heading + .card-desc { margin:-12rpx 0 22rpx 102rpx; }
button.btn { width:100% !important; margin:20rpx 0 0; padding:22rpx 20rpx; border-radius:18rpx; font-size:28rpx; box-sizing:border-box; min-height:48px; }
.actions button.btn { width:auto !important; }
.input { height:174rpx; padding:22rpx; border-radius:18rpx; }
.backup-empty { display:flex; flex-direction:column; align-items:center; gap:14rpx; padding:30rpx 18rpx; margin-top:20rpx; border:1rpx dashed var(--border); border-radius:18rpx; background:var(--input); text-align:center; }
.backup-empty image { width:50rpx; height:50rpx; }
.backup-empty .empty-title { font-size:28rpx; font-weight:600; color:var(--muted); }
.backup-empty .card-desc { margin:0; }
