@import "../styles/interaction.wxss";
.tabbar { position: fixed; z-index: 50; bottom: 0; left: 0; right: 0; display: flex; gap: 24rpx; padding: 12rpx 24rpx 10rpx; background: var(--surface); border-radius: 38rpx 38rpx 0 0; box-sizing: border-box; }
.tab { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; min-height: 96rpx; padding: 6rpx 0; margin: 0; border-radius: 28rpx; background: transparent; color: var(--muted); font-size: 24rpx; font-weight: 400; line-height: 1.3; }
.tab::after { border: 0; }
.icon { width: 48rpx; height: 48rpx; }
.active { color: var(--accent); font-weight: 600; }
.theme-cream .active { background: var(--soft); }
.theme-paper,.theme-swiss,.theme-pixel { border-top:1rpx solid var(--border); border-radius:0; }
.theme-paper { background-color:var(--page); background-image:var(--page-texture); font-family:var(--font-family); }
.theme-paper .tab,.theme-swiss .tab,.theme-pixel .tab { position:relative; border-radius:0; background:transparent; }
.theme-paper .active::before,.theme-swiss .active::before,.theme-pixel .active::before { content:''; position:absolute; bottom:0; height:3rpx; left:36%; right:36%; background:var(--accent); }
.theme-swiss .active::before { left:4%; right:4%; height:4rpx; background:var(--primary); }
.theme-paper .icon { width:43rpx; height:43rpx; }.theme-swiss .icon { width:48rpx; height:48rpx; }
.theme-pixel { background:var(--page); }.theme-pixel .active::before { left:33%; right:33%; height:4rpx; }

.theme-paper .tab { font-size:25rpx; font-weight:400; }.theme-paper .active { font-weight:700; }
.theme-paper .active::before { left:43%; right:43%; }
.theme-swiss .active,.theme-pixel .active { font-weight:700; }

/* The 96rpx tab must not shrink below the native touch floor on 320px phones. */
@media (max-width:343px) {
  .tab { min-height:44px; }
}

.theme-aqua { left:64rpx; right:64rpx; gap:20rpx; padding:12rpx; border:0; border-radius:100rpx; background:#FFFFFF; box-shadow:0 12rpx 70rpx rgba(43,76,92,0.12); }
.theme-aqua .tab { flex-direction:row; gap:18rpx; height:80rpx; min-height:44px; box-sizing:border-box; padding:6rpx 12rpx; border-radius:80rpx; color:#637384; font-size:28rpx; font-weight:600; }
.theme-aqua .active { color:var(--text); background:linear-gradient(100deg,#ECFCFF,#E9FCF8); }
.theme-aqua .icon { width:52rpx; height:52rpx; flex-shrink:0; }
@media (max-width:343px) {
  .theme-aqua { left:36rpx; right:36rpx; gap:12rpx; }
  .theme-aqua .tab { min-height:44px; gap:12rpx; }
}
